{% comment %}
  Animal for Animal Impact Section
{% endcomment %}

<section class="animal-impact-section">
  <div class="animal-impact-section__container">
    <div class="animal-impact-section__columns">
      <div class="animal-impact-section__column animal-impact-section__column--left">
        <img
          src="{{ 'dog.webp' | asset_url }}"
          alt="Animal for Animal Impact"
          loading="lazy"
          class="animal-impact-section__image"
        >
      </div>
      <div class="animal-impact-section__column animal-impact-section__column--right">
        <h2 class="animal-impact-section__title">A portion of our proceeds goes toward animal welfare.</h2>
        <p class="animal-impact-section__description">
          With every order you place, you are not just buying a product; you're providing nourishment to around 10 stray
          animals. Your purchase becomes their meal, and your compassion is the reason they can find hope amid the
          challenges of life on the streets. Thank you for making a difference, one order at a time.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .animal-impact-section {
    height: 100%;
    width: 100%;
    padding: 1rem;
    padding-bottom: 0;
    background: #fef9f2 url('{{ "noise.png" | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
  }

  .animal-impact-section__container {
    max-width: 100%;
    margin: 0 auto;
  }

  .animal-impact-section__columns {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 1rem;
    width: 100%;
  }

  .animal-impact-section__column {
    background: #fe5f78 url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    border-radius: 16px;
  }

  .animal-impact-section__column--right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .animal-impact-section__title {
    font-family: 'Instrument Serif', serif;
    font-size: 48px;
    font-weight: 300;
    line-height: 1.3;
    margin-bottom: 2rem;
    color: #fff;
    text-transform: none;
    font-style: normal;
    text-align: center;
    width: 80%;
  }

  .animal-impact-section__description {
    font-family: 'Inter', sans-serif;
    font-size: 19px;
    font-weight: 400;
    margin: 0;
    color: #fef9f2;
    line-height: 1.4;
    text-align: center;
    width: 80%;
  }

  .animal-impact-section__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
  }

  /* Mobile responsive adjustments */
  @media screen and (max-width: 480px) {
    .animal-impact-section {
      padding: 0rem 1rem 1rem;
    }

    .animal-impact-section__columns {
      grid-template-columns: 1fr;
      gap: 1rem;
      display: flex;
      flex-direction: column;
    }

    .animal-impact-section__column {
      min-height: 180px;
    }

    .animal-impact-section__column--right {
      padding: 1.5rem;
    }

    .animal-impact-section__column--right h2 {
      width: 80%;
    }

    .animal-impact-section__title {
      font-size: 1.8rem;
      margin-bottom: 1rem;
      line-height: 1.1;
    }

    .animal-impact-section__description {
      font-size: 1rem;
      width: 90%;
      line-height: 1.3;
    }
  }
</style>
