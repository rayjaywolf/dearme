{% comment %}
About Philosophy Section
{% endcomment %}

<section class="about-philosophy">
  <div class="about-philosophy__container">
    <div class="about-philosophy__header">
      <p class="section_numbering">01</p>
      <h2 class="about-philosophy__title">The
        <em>Philosophy</em>
      </h2>
    </div>
    <div class="about-philosophy__content">
      <div class="about-philosophy__image-wrapper">
        <img src="{{ 'A7409882.jpg' | asset_url }}" alt="" class="about-philosophy__image">
      </div>
      <div class="about-philosophy__content__text">
        <h1 class="about-philosophy__content__text__title">Skincare, not as a routine <br> but a <em>ritual</em>.</h1>
        <p class="about-philosophy__description">We believe beauty begins with balance. Our formulations are built to
          restore harmony between your skin, your mind, and the natural world.
        </p>
      </div>
    </div>
  </div>

  <style>
    .about-philosophy {
      background: #fef9f2 url('{{ "noise.png" | asset_url }}');
      background-size: 150px 150px;
      background-repeat: repeat;
      height: fit-content;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      padding: 4rem 1rem;
    }

    .about-philosophy__container {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3rem;
      width: 100%;
    }

    .about-philosophy__header {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }

    .section_numbering {
      color: #63001f;
      font-size: 10px;
      font-weight: regular;
      letter-spacing: 0;
      line-height: 2;
    }

    .about-philosophy__title {
      font-family: "Instrument Serif";
      color: #63001f;
      font-size: 36px;
      font-weight: 200;
      letter-spacing: 0;
      line-height: 1.1;
    }

    .about-philosophy__content {
      display: flex;
      align-items: stretch;
      justify-content: center;
      gap: 1rem;
      width: 100%;
    }

    .about-philosophy__image-wrapper {
      flex: 1;
      position: relative;
      border-radius: 16px;
      overflow: hidden;
    }

    .about-philosophy__image {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
    }

    .about-philosophy__content__text {
      flex: 1;
      padding-top: 8rem;
      padding-bottom: 8rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 2rem;
    }

    .about-philosophy__content__text__title {
      font-family: "Instrument Serif";
      font-size: 3rem;
      font-weight: 200;
      color: #000;
      line-height: 1.2;
      text-align: center;
    }

    .about-philosophy__description {
      font-size: 14px;
      font-weight: regular;
      color: #444;
      line-height: 1.7;
      text-align: center;
      width: 80%;
    }

    @media screen and (max-width: 480px) {
      .about-philosophy {
        padding: 2rem 0.5rem 3rem;
      }

      .about-philosophy__container {
        gap: 2rem;
      }

      .about-philosophy__header {}

      .section_numbering {
        color: #63001f;
        font-size: 8px;
        font-weight: regular;
        letter-spacing: 0;
        line-height: 2;
      }

      .about-philosophy__title {
        font-size: 30px;
      }

      .about-philosophy__content {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 3rem;
      }

      .about-philosophy__image-wrapper {
        flex: initial;
        width: 100%;
        height: 250px;
      }

      .about-philosophy__image {
        height: 100%;
        width: 100%;
        object-fit: cover;
      }

      .about-philosophy__content__text {
        padding-top: 0;
        padding-bottom: 0;
      }

      .about-philosophy__content__text__title {
        font-size: 2rem;
      }

      .about-philosophy__description {
        font-size: 12px;
        width: 80%;
        margin: 0 auto;
      }
    }
  </style>
</section>

{% schema %}
{
"name": "About Philosophy",
"settings": [],
"presets": [
{
"name": "About Philosophy"
}
]
}
{% endschema %}