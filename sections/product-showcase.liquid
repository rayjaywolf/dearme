{% comment %}
  Product Showcase section
{% endcomment %}

<section
  class="product-showcase-section"
  style="background: {{ section.settings.background_color }} url('{{ "noise.png" | asset_url }}'); background-size: 150px 150px; background-repeat: repeat;"
>
  <div class="product-showcase-section__container">
    <div class="product-showcase-section__grid">
      <!-- Left Column: Skin Concerns -->
      <div class="product-showcase-section__column product-showcase-section__column--left">
        {%- if section.settings.concerns_subheading != blank -%}
          <h3 class="product-showcase-section__concerns-subheading">
            {{ section.settings.concerns_subheading }}
          </h3>
        {%- endif -%}
        <div class="product-showcase-section__concerns-list">
          <div class="product-showcase-section__concern">
            <div class="product-showcase-section__concern-problem">{{ section.settings.concern_1_problem }}</div>
            <div class="product-showcase-section__concern-arrow" aria-hidden="true">↓</div>
            <div class="product-showcase-section__concern-solution">{{ section.settings.concern_1_solution }}</div>
          </div>
          <div class="product-showcase-section__concern">
            <div class="product-showcase-section__concern-problem">{{ section.settings.concern_2_problem }}</div>
            <div class="product-showcase-section__concern-arrow" aria-hidden="true">↓</div>
            <div class="product-showcase-section__concern-solution">{{ section.settings.concern_2_solution }}</div>
          </div>
          <div class="product-showcase-section__concern">
            <div class="product-showcase-section__concern-problem">{{ section.settings.concern_3_problem }}</div>
            <div class="product-showcase-section__concern-arrow" aria-hidden="true">↓</div>
            <div class="product-showcase-section__concern-solution">{{ section.settings.concern_3_solution }}</div>
          </div>
          <div class="product-showcase-section__concern">
            <div class="product-showcase-section__concern-problem">{{ section.settings.concern_4_problem }}</div>
            <div class="product-showcase-section__concern-arrow" aria-hidden="true">↓</div>
            <div class="product-showcase-section__concern-solution">
              {{ section.settings.concern_4_solution }}
            </div>
          </div>
        </div>
      </div>

      <!-- Center Column: Product Image -->
      <div class="product-showcase-section__column product-showcase-section__column--center">
        <img
          src="{{ 'bottle.png' | asset_url }}"
          alt="{{ section.settings.product_image_alt }}"
          class="product-showcase-section__image"
          loading="lazy"
          width="300"
          height="300"
        >
      </div>

      <!-- Right Column: Product Info -->
      <div class="product-showcase-section__column product-showcase-section__column--right">
        <h2 class="product-showcase__title">{{ section.settings.product_title }}</h2>
        {%- if section.settings.product_subtitle != blank -%}
          <h3 class="product-showcase__subtitle">{{ section.settings.product_subtitle }}</h3>
        {%- endif -%}
        {%- if section.settings.product_description != blank -%}
          <p class="product-showcase__description">
            {{ section.settings.product_description }}
          </p>
        {%- endif -%}
        <div class="product-showcase__actions">
          <a
            href="{{ section.settings.button_url }}"
            class="product-showcase__button"
            style=""
          >
            <span class="product-showcase__button-text" style="">{{ section.settings.button_text }}</span>
            <div class="product-showcase__cta" style="">
              <svg
                class="product-showcase__cta-icon"
                width="13"
                height="8"
                viewBox="0 0 13 8"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                style=""
              >
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
              <svg
                class="product-showcase__cta-icon"
                width="13"
                height="8"
                viewBox="0 0 13 8"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                style="fill: {{ section.settings.button_arrow_color }};"
              >
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .product-showcase-section {
    height: 100%;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    background-color: #ead1c1 !important;
    padding: 4rem 3rem;
  }

  .product-showcase-section__container {
    text-align: center;
  }

  .product-showcase-section__title {
    font-weight: 200;
    font-size: 3rem;
    margin: 0 0 2rem 0;
    line-height: 0.9;
    color: #63001f;
    text-align: center;
    text-transform: capitalize;
    span {
      font-style: italic;
    }
  }

  .product-showcase-section__description {
    text-align: left;
    font-family: 'Inter', serif;
    font-size: 14px;
    line-height: 1.4;
    margin: 0 0 3rem 0;
    max-width: 100%;
    color: #444;
    text-align: center;
  }

  .product-showcase-section__grid {
    display: grid;
    align-items: center;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .product-showcase-section__column {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .product-showcase-section__column--left {
    align-items: flex-start;
    text-align: left;
  }

  .product-showcase-section__column--center {
    align-items: center;
  }

  .product-showcase-section__column--right {
    align-items: center;
    text-align: center;
    margin-right: -0.5rem;
  }

  .product-showcase-section__concerns-subheading {
    font-size: 14px;
    color: #444;
    margin: 0 0 4rem 0;
    line-height: 1.7;
    text-transform: none;
    font-weight: 400;
    text-align: center;
    /* text-transform: uppercase; */
  }

  .product-showcase-section__concerns-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 2rem;
    width: 100%;
  }

  .product-showcase-section__concern {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
  }

  .product-showcase-section__concern-arrow {
    font-size: 16px;
    color: #63001f;
    letter-spacing: 0.1em;
  }

  .product-showcase-section__concern-problem {
    font-family: 'Inter', serif;
    text-transform: uppercase;
    font-weight: bold;
    font-size: 14px;
    color: #63001f;
    letter-spacing: 0.01em;
  }

  .product-showcase-section__concern-solution {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #444;
    line-height: 1.65;
    letter-spacing: 0.02em;
    max-width: 360px;
    /* text-transform: uppercase; */
  }

  .product-showcase__title {
    font-family: 'Instrument Serif', serif;
    font-weight: 200;
    font-size: 3rem;
    margin: 0 0 2rem 0;
    line-height: 0.9;
    color: #63001f;
    text-align: center;
    text-transform: capitalize;
    span {
      font-style: italic;
    }
  }

  .product-showcase__subtitle {
    font-weight: 400;
    font-size: 1.2rem;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    line-height: 1.4;
    width: 100%;
    color: #63001f;
    text-align: center;
  }

  .product-showcase__description {
    font-family: 'Inter', serif;
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 3rem 0;
    max-width: 100%;
    color: #444;
    text-align: center;
  }

  .product-showcase-section__image {
    max-width: 85%;
    height: auto;
    display: block;
    margin: 0 auto;
    margin-left: 110px;
    grid-column: 1;
  }

  .product-showcase-section__image-container > div:last-child {
    grid-column: 2;
  }

  .product-showcase__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    opacity: 1;
    align-items: center;
    justify-content: center;
  }

  .product-showcase__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    background-color: #63001f;
    color: #ffffff;
    border: none;
    gap: 1rem;
    overflow: hidden;
    max-width: 220px;
  }

  .product-showcase__button-text {
    margin-right: 3rem;
    padding-left: 1rem;
    color: #ffffff;
  }

  .product-showcase__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    background: #ffffff;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
  }

  .product-showcase__cta-icon {
    width: 15px;
    height: 10px;
    fill: #63001f;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
  }

  .product-showcase__cta .product-showcase__cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .product-showcase__button:hover .product-showcase__cta .product-showcase__cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .product-showcase__button:hover .product-showcase__cta .product-showcase__cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .product-showcase__button:hover {
    background-color: #ffffff !important;
    color: #63001f !important;
    border: none !important;
  }

  .product-showcase__button:hover .product-showcase__button-text {
    color: #63001f !important;
  }

  .product-showcase__button:hover .product-showcase__cta {
    background: #63001f !important;
  }

  .product-showcase__button:hover .product-showcase__cta-icon {
    fill: #ffffff !important;
  }

  /* Mobile responsive adjustments */
  @media screen and (max-width: 480px) {
    .product-showcase-section {
      padding: 2rem 1rem;
    }

    .product-showcase-section__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      display: flex;
      flex-direction: column;
    }

    .product-showcase-section__column--left {
      order: 3;
    }

    .product-showcase-section__column--center {
      order: 1;
    }

    .product-showcase-section__column--right {
      order: 2;
    }

    .product-showcase-section__column--left,
    .product-showcase-section__column--right {
      align-items: center;
      text-align: center;
    }

    .product-showcase-section__title,
    .product-showcase__title {
      font-size: 2rem;
      /* margin-bottom: 1rem; */
    }

    .product-showcase__subtitle {
      font-size: 14px;
      margin-bottom: 1rem;
      line-height: 1.7;
    }

    .product-showcase__description {
      font-size: 12px;
      margin-bottom: 2rem;
      line-height: 1.7;
    }

    .product-showcase-section__image {
      max-width: 60%;
      margin: 0 auto 0 6.25rem;
      display: block;
      margin-bottom: -1.2rem;
    }

    .product-showcase-section__concerns-subheading {
      font-size: 12px;
      margin-bottom: 2rem;
      line-height: 1.7;
    }

    .product-showcase-section__concerns-list {
      gap: 1.5rem;
      grid-template-columns: 1fr;
    }

    .product-showcase-section__concern {
      text-align: center;
    }

    .product-showcase-section__concern-problem {
      font-size: 12px;
    }

    .product-showcase-section__concern-solution {
      font-size: 11px;
      line-height: 1.4;
    }

    .product-showcase__button {
      max-width: 180px;
      font-size: 0.7rem;
      padding: 0.4rem 0.4rem;
      gap: 0.8rem;
    }

    .product-showcase__button-text {
      margin-right: 2rem;
      padding-left: 0.8rem;
    }

    .product-showcase__cta {
      width: 2rem;
      height: 2rem;
    }

    .product-showcase__cta-icon {
      width: 12px;
      height: 8px;
    }
  }
</style>

