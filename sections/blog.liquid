{% comment %}
  Modern blog listing page with hero section, featured articles, and grid layout
  Following BEM naming convention and brand aesthetic
{% endcomment %}

<section
  class="blog-hero"
  style="background: {{ section.settings.hero_bg_color }} url('{{ "noise.png" | asset_url }}'); background-size: 150px 150px; background-repeat: repeat;"
>
  <div class="blog-hero__container">
    <div class="blog-hero__content">
      <h1
        class="blog-hero__title"
        style="font-family: {{ section.settings.title_font }}, serif; color: {{ section.settings.title_color }};"
      >
        {{ blog.title | default: 'Our Stories' }}
      </h1>
      <p
        class="blog-hero__subtitle"
        style="font-family: {{ section.settings.subtitle_font }}, sans-serif; color: {{ section.settings.subtitle_color }};"
      >
        {{
          section.settings.hero_description
          | default: 'Discover insights, stories, and inspiration from our journey'
        }}
      </p>
    </div>
  </div>
</section>

<section class="blog-content">
  <div class="blog-content__container">
    <!-- Featured Article (First Article) -->
    {% assign featured_article = blog.articles.first %}
    {% if featured_article %}
      <div class="blog-content__featured">
        <a href="{{ featured_article.url }}" class="blog-content__featured-link">
          <div class="blog-content__featured-media">
            {% if featured_article.image %}
              <img
                src="{{ featured_article.image | image_url: width: 1200 }}"
                alt="{{ featured_article.title }}"
                class="blog-content__featured-image"
                width="1200"
                height="750"
                loading="eager"
              >
            {% endif %}
            <div class="blog-content__featured-overlay">
              <span class="blog-content__featured-badge">Featured</span>
            </div>
          </div>
          <div class="blog-content__featured-content">
            <div class="blog-content__featured-meta">
              <span class="blog-content__featured-date">
                {{- featured_article.published_at | time_tag: format: 'date' -}}
              </span>
              {% if featured_article.tags.size > 0 %}
                <span class="blog-content__featured-tag">{{ featured_article.tags.first }}</span>
              {% endif %}
            </div>
            <h2
              class="blog-content__featured-title"
              style="font-family: {{ section.settings.featured_title_font }}, serif; color: {{ section.settings.featured_title_color }};"
            >
              {{ featured_article.title }}
            </h2>
            <p
              class="blog-content__featured-excerpt"
              style="font-family: {{ section.settings.excerpt_font }}, sans-serif; color: {{ section.settings.excerpt_color }};"
            >
              {{ featured_article.excerpt | default: featured_article.content | strip_html | truncate: 150 }}
            </p>
            <div class="blog-content__featured-cta">
              <span class="blog-content__featured-cta-text">Read Article</span>
              <div class="blog-content__featured-cta-arrow">
                <svg
                  class="blog-content__featured-cta-icon"
                  width="13"
                  height="8"
                  viewBox="0 0 13 8"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
                </svg>
                <svg
                  class="blog-content__featured-cta-icon"
                  width="13"
                  height="8"
                  viewBox="0 0 13 8"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
                </svg>
              </div>
            </div>
          </div>
        </a>
      </div>
    {% endif %}

    <!-- Articles Grid -->
    <div class="blog-content__grid">
      {% paginate blog.articles by 9 %}
        {% for article in blog.articles %}
          <article
            class="blog-content__article blog-content__article--first"
            style="{% if forloop.first %}display: none;{% endif %}"
          >
            <a href="{{ article.url }}" class="blog-content__article-link">
              <div class="blog-content__article-media">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    alt="{{ article.title }}"
                    class="blog-content__article-image"
                    width="600"
                    height="375"
                    loading="lazy"
                  >
                {% else %}
                  <div class="blog-content__article-placeholder">
                    <svg
                      width="48"
                      height="48"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21,15 16,10 5,21"/>
                    </svg>
                  </div>
                {% endif %}
                <div class="blog-content__article-overlay">
                  <svg class="blog-content__article-cta-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
              <div class="blog-content__article-content">
                <div class="blog-content__article-meta">
                  <span class="blog-content__article-date">{{ article.published_at | time_tag: format: 'date' }}</span>
                  {% if article.tags.size > 0 %}
                    <span class="blog-content__article-tag">{{ article.tags.first }}</span>
                  {% endif %}
                </div>
                <h3
                  class="blog-content__article-title"
                  style="font-family: {{ section.settings.article_title_font }}, serif; color: {{ section.settings.article_title_color }};"
                >
                  {{ article.title }}
                </h3>
                <p
                  class="blog-content__article-excerpt"
                  style="font-family: {{ section.settings.article_excerpt_font }}, sans-serif; color: {{ section.settings.article_excerpt_color }};"
                >
                  {{ article.excerpt | default: article.content | strip_html | truncate: 100 }}
                </p>
              </div>
            </a>
          </article>
        {% endfor %}
      {% endpaginate %}
    </div>

    <!-- Pagination -->
    {% comment %} paginate object is available within paginate block {% endcomment %}
    {% if paginate.pages > 1 %}
      <div class="blog-content__pagination">
        {% if paginate.previous %}
          <a
            href="{{ paginate.previous.url }}"
            class="blog-content__pagination-link blog-content__pagination-link--prev"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Previous
          </a>
        {% endif %}

        <div class="blog-content__pagination-numbers">
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="blog-content__pagination-number">{{ part.title }}</a>
            {% else %}
              <span class="blog-content__pagination-number blog-content__pagination-number--current">
                {{- part.title -}}
              </span>
            {% endif %}
          {% endfor %}
        </div>

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="blog-content__pagination-link blog-content__pagination-link--next">
            Next
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  /* Blog Hero Section */
  .blog-hero {
    width: 100%;
    min-height: 35vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background-color: #ead1c1;
    margin-top: 5rem;
  }

  .blog-hero__container {
    max-width: 1200px;
    width: 100%;
    padding: 4rem 2rem;
    text-align: center;
  }

  .blog-hero__content {
    max-width: 800px;
    margin: 0 auto;
  }

  .blog-hero__title {
    font-size: 48px;
    font-weight: 200;
    line-height: 1.1;
    margin: 0 0 1rem 0;
    color: #63001f;
  }

  .blog-hero__subtitle {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    color: #63001f;
    opacity: 0.8;
  }

  /* Blog Content Section */
  .blog-content {
    width: 100%;
    background: #fef9f2 url('{{ "noise.png" | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
    padding: 4rem 0;
  }

  .blog-content__container {
    max-width: 85%;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Featured Article */
  .blog-content__featured {
    margin-bottom: 3rem;
  }

  .blog-content__featured-link {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }

  .blog-content__featured-link:hover {
  }

  .blog-content__featured-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16/10;
  }

  .blog-content__featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
  }

  .blog-content__featured-overlay {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
  }

  .blog-content__featured-badge {
    background: #63001f;
    color: #ffffff;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-content__featured-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 0;
  }

  .blog-content__featured-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .blog-content__featured-date {
    font-size: 0.9rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-content__featured-tag {
    background: #63001f;
    color: #fef9f2;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
  }

  .blog-content__featured-title {
    font-size: 2.5rem;
    font-weight: 200;
    line-height: 1.2;
    margin: 0 0 1.5rem 0;
    color: #63001f;
  }

  .blog-content__featured-excerpt {
    font-size: 1.1rem;
    line-height: 1.6;
    margin: 0 0 2rem 0;
    color: #666;
  }

  .blog-content__featured-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    gap: 4rem;
    overflow: hidden;
    background-color: #ffffff;
    color: #63001f;
    /* border: 1px solid #63001f; */
    max-width: 250px;
    margin-top: 1rem;
  }

  .blog-content__featured-cta-text {
    margin-right: 1rem;
    padding-left: 1rem;
  }

  .blog-content__featured-cta-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
    background: #63001f;
  }

  .blog-content__featured-cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
    fill: #ffffff;
  }

  .blog-content__featured-cta-arrow .blog-content__featured-cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .blog-content__featured-cta:hover .blog-content__featured-cta-arrow .blog-content__featured-cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .blog-content__featured-cta:hover .blog-content__featured-cta-arrow .blog-content__featured-cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .blog-content__featured-cta {
    background-color: #63001f !important;
    color: #ffffff !important;
  }

  .blog-content__featured-cta .blog-content__featured-cta-text {
    color: #ffffff !important;
  }

  .blog-content__featured-cta .blog-content__featured-cta-arrow {
    background: #ffffff !important;
  }

  .blog-content__featured-cta .blog-content__featured-cta-icon {
    fill: #63001f !important;
  }

  .blog-content__featured-cta:hover {
    background-color: #ffffff !important;
    color: #63001f !important;
    /* border: 1px solid #63001f !important; */
  }

  .blog-content__featured-cta:hover .blog-content__featured-cta-text {
    color: #63001f !important;
  }

  .blog-content__featured-cta:hover .blog-content__featured-cta-arrow {
    background: #63001f !important;
  }

  .blog-content__featured-cta:hover .blog-content__featured-cta-icon {
    fill: #ffffff !important;
  }

  /* Articles Grid */
  .blog-content__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .blog-content__article {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .blog-content__article:hover {
  }

  .blog-content__article-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .blog-content__article-media {
    position: relative;
    aspect-ratio: 16/12;
    overflow: hidden;
  }

  .blog-content__article-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    transition: transform 0.3s ease;
  }

  .blog-content__article:hover .blog-content__article-image {
    transform: scale(1.05);
  }

  .blog-content__article-placeholder {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ccc;
  }

  .blog-content__article-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #63001f;
    opacity: 0;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .blog-content__article:hover .blog-content__article-overlay {
    opacity: 1;
  }

  .blog-content__article-content {
    padding: 2rem;
  }

  .blog-content__article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .blog-content__article-date {
    font-size: 0.8rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-content__article-tag {
    background: #63001f;
    color: #fef9f2;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 10px;
    font-weight: 400;
    text-transform: uppercase;
  }

  .blog-content__article-title {
    font-size: 1.5rem;
    font-weight: 200;
    line-height: 1.3;
    margin: 0 0 1rem 0;
    color: #63001f;
  }

  .blog-content__article-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    color: #666;
  }

  /* Pagination */
  .blog-content__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e5e5;
  }

  .blog-content__pagination-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border: 2px solid #e5e5e5;
    border-radius: 50px;
    color: #666;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .blog-content__pagination-link:hover {
    border-color: #63001f;
    background: #63001f;
    color: #ffffff;
  }

  .blog-content__pagination-numbers {
    display: flex;
    gap: 0.5rem;
  }

  .blog-content__pagination-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 2px solid #e5e5e5;
    border-radius: 50%;
    color: #666;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .blog-content__pagination-number:hover {
    border-color: #63001f;
    background: #63001f;
    color: #ffffff;
  }

  .blog-content__pagination-number--current {
    border-color: #63001f;
    background: #63001f;
    color: #ffffff;
  }

  /* Responsive Design */
  @media screen and (max-width: 768px) {
    .blog-hero__title {
      font-size: 2.5rem;
    }

    .blog-hero__subtitle {
      font-size: 1.1rem;
    }

    .blog-content__featured-link {
      display: block;
      background: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      transition: all 0.3s ease;
    }

    .blog-content__featured-media {
      aspect-ratio: 16/12;
    }

    .blog-content__featured-overlay {
      display: none;
    }

    .blog-content__featured-content {
      padding: 2rem;
    }

    .blog-content__featured-title {
      font-size: 1.5rem;
      font-weight: 200;
      line-height: 1.3;
      margin: 0 0 1rem 0;
      color: #63001f;
    }

    .blog-content__featured-excerpt {
      font-size: 0.95rem;
      line-height: 1.6;
      margin: 0;
      color: #666;
    }

    .blog-content__featured-cta {
      display: none;
    }

    /* Show first article in grid on mobile */
    .blog-content__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    /* Show first article on mobile */
    .blog-content__article--first {
      display: block !important;
    }

    .blog-content__pagination {
      flex-direction: column;
      gap: 1.5rem;
    }

    .blog-content__pagination-numbers {
      order: -1;
    }
  }

  @media screen and (max-width: 480px) {
    .blog-hero {
      min-height: 20vh;
      margin-top: 4rem;
    }

    .blog-hero__title {
      font-size: 40px !important;
      margin: 0 0 1rem 0;
    }

    .blog-hero__subtitle {
      font-size: 12px;
      width: 70%;
      margin: 0 auto;
    }

    .blog-hero__container {
      padding: 2rem 1rem;
    }

    .blog-content {
      padding: 3rem 0;
    }

    .blog-content__container {
      max-width: 100%;
      padding: 0 1rem;
    }

    .blog-hero__title {
      font-size: 2rem;
    }

    .blog-content__featured {
      margin-bottom: 1.5rem;
    }

    .blog-content__featured-title {
      font-size: 1.5rem;
    }

    .blog-content__article-content {
      padding: 1.5rem;
    }

    .blog-content__article-title {
      font-size: 1.25rem;
    }
  }

  /* Search and Filter Functionality */
  .blog-content__article[style*='display: none'] {
    display: none !important;
  }

  .blog-content__article.hidden {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Blog Page",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "Hero Background Color",
      "default": "#ead1c1"
    },
    {
      "type": "text",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "Discover insights, stories, and inspiration from our journey"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Title Font",
      "options": [
        {
          "value": "Instrument Serif",
          "label": "Instrument Serif"
        },
        {
          "value": "PPEditorial New",
          "label": "PPEditorial New"
        },
        {
          "value": "Gumani",
          "label": "Gumani"
        }
      ],
      "default": "Instrument Serif"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#63001f"
    },
    {
      "type": "select",
      "id": "subtitle_font",
      "label": "Subtitle Font",
      "options": [
        {
          "value": "Inter",
          "label": "Inter"
        },
        {
          "value": "Work Sans",
          "label": "Work Sans"
        }
      ],
      "default": "Inter"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#63001f"
    },
    {
      "type": "header",
      "content": "Featured Article"
    },
    {
      "type": "select",
      "id": "featured_title_font",
      "label": "Featured Title Font",
      "options": [
        {
          "value": "Instrument Serif",
          "label": "Instrument Serif"
        },
        {
          "value": "PPEditorial New",
          "label": "PPEditorial New"
        },
