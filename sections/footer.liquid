<script>
  document.addEventListener('DOMContentLoaded', function () {
    console.log('Footer script loaded');

    const searchTrigger = document.getElementById('search-trigger');
    const searchPopup = document.getElementById('search-popup');
    const searchClose = document.getElementById('search-close');
    const searchInput = document.querySelector('.search-popup-input');

    console.log('Elements found:', {
      searchTrigger: !!searchTrigger,
      searchPopup: !!searchPopup,
      searchClose: !!searchClose,
      searchInput: !!searchInput,
    });

    if (!searchTrigger || !searchPopup) {
      console.error('Required elements not found');
      return;
    }

    // Open search popup
    searchTrigger.addEventListener('click', function (e) {
      e.preventDefault();
      console.log('Search trigger clicked');
      console.log('Popup element:', searchPopup);
      console.log('Popup classes before:', searchPopup.className);
      searchPopup.classList.add('active');
      console.log('Popup classes after:', searchPopup.className);
      console.log('Popup computed style display:', window.getComputedStyle(searchPopup).display);
      // Focus on input after animation
      setTimeout(() => {
        if (searchInput) {
          searchInput.focus();
        }
      }, 100);
    });

    // Close search popup
    function closeSearchPopup() {
      console.log('Closing search popup');
      searchPopup.classList.remove('active');
    }

    if (searchClose) {
      searchClose.addEventListener('click', closeSearchPopup);
    }

    // Close popup when clicking outside
    searchPopup.addEventListener('click', function (e) {
      if (e.target === searchPopup) {
        closeSearchPopup();
      }
    });

    // Close popup with Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && searchPopup.classList.contains('active')) {
        closeSearchPopup();
      }
    });

    // Prevent form submission if input is empty
    const searchForm = document.querySelector('.search-popup-form');
    if (searchForm) {
      searchForm.addEventListener('submit', function (e) {
        if (!searchInput.value.trim()) {
          e.preventDefault();
          searchInput.focus();
        }
      });
    }
  });
</script>
