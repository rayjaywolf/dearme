<style>
  .custom-footer {
    background: #63001f;
    color: #fff;
    padding: 0 4rem 3rem;
    position: sticky;
    bottom: 0;
    z-index: 0;
  }
  .footer-content {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: start;
    max-width: 1400px;
    margin: 0 auto;
    /* gap: 2.5rem; */
    padding-top: 4rem;
    padding-bottom: 0;
  }
  .footer-links-col {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    font-size: 1.05rem;
  }
  .footer-links-row {
    display: flex;
    gap: 8rem;
  }
  .footer-links-title {
    font-family: 'Instrument serif', serif;
    font-size: 22px;
    color: #ead1c1;
    margin-bottom: 0.7rem;
  }
  .footer-links-link {
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s;
  }
  .footer-links-col a:hover {
    opacity: 1;
    text-decoration: underline;
  }
  .footer-logo-col {
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .footer-logo {
    width: 180px;
  }
  .footer-newsletter-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
    justify-content: flex-start;
  }
  .footer-newsletter-title {
    font-size: 0.9rem;
    font-family: 'Inter', serif;
    margin-bottom: 0.5rem;
    color: #fff;
    opacity: 0.75;
    font-weight: 400;
    line-height: 1.4;
  }
  .footer-newsletter-subtitle {
    font-size: 1rem;
    font-family: 'Inter', serif;
    color: #fff;
    line-height: 1.4;
    margin-bottom: 0.75rem;
    font-weight: bold;
  }
  .footer-newsletter-form {
    display: flex;
    width: 100%;
    border: 1px solid #ead1c1;
    border-radius: 2px;
    overflow: hidden;
    background: transparent;
  }
  .footer-newsletter-form input[type='email'] {
    flex: 1;
    padding: 0.7rem 1rem;
    border: none;
    background: transparent;
    color: #fff;
    font-size: 1rem;
    outline: none;
  }
  .footer-newsletter-form input[type='email']::placeholder {
    color: #fff;
    opacity: 0.75;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.4;
  }
  .footer-newsletter-form button {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.5rem;
    padding: 0 1rem;
    cursor: pointer;
    transition: color 0.2s;
    transform: translateY(-1px);
  }
  .footer-newsletter-form button:hover {
    color: #e95d8d;
  }
  .footer-copyright {
    text-align: center;
    color: #fff;
    opacity: 0.7;
    font-size: 0.95rem;
    margin-top: 2.5rem;
  }
  @media (max-width: 480px) {
    .custom-footer {
      padding: 2rem 1rem 2rem;
      width: 100%;
    }
    .footer-content {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      text-align: center;
      padding-top: 0rem;
    }
    .footer-links-link {
      font-size: 12px;
    }
    .footer-links-row {
      margin: 0 auto;
      gap: 2rem;
    }
    .footer-links-col,
    .footer-logo-col,
    .footer-newsletter-col {
      align-items: center;
      justify-content: flex-start;
    }
    .footer-logo {
      margin: 0 auto;
      width: 140px;
    }
    .footer-newsletter-form {
      max-width: 100%;
    }
    .footer-newsletter-title {
      font-size: 14px;
    }
    .footer-newsletter-subtitle {
      font-size: 14px;
    }
  }
  .footer-social-row {
    display: flex;
    gap: 1.2rem;
    margin-top: 1.2rem;
  }
  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s, transform 0.2s;
    opacity: 0.85;
    color: #fff;
  }
  .footer-social-link:hover {
    opacity: 1;
  }
  .footer-social-img {
    width: 28px;
    height: 28px;
    display: block;
  }
  .footer-social-icon {
    width: 28px;
    height: 28px;
    display: block;
    fill: currentColor;
  }
  .footer-social-icon-instagram {
    width: 26px;
    height: 26px;
  }
  .footer-social-icon-facebook {
    width: 32px;
    height: 32px;
  }
  .footer-social-img-youtube {
    width: 32px;
    height: 32px;
  }

  .footer-copyright {
    font-size: 14px;
  }

  /* Search Popup Styles */
  .search-popup {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: rgba(0, 0, 0, 0.4) !important;
    display: none !important;
    justify-content: center !important;
    align-items: center !important;
    z-index: 99999 !important;
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .search-popup.active {
    display: flex !important;
    opacity: 1;
  }

  .search-popup-content {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20px;
    padding: 0;
    width: 90%;
    max-width: 600px;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
    transform: translateY(20px) scale(0.95);
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(20px);
  }

  .search-popup.active .search-popup-content {
    transform: translateY(0) scale(1);
  }

  .search-popup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1rem 1rem;
    border-bottom: 1px solid rgba(99, 0, 31, 0.1);
  }

  .search-popup-header h3 {
    margin: 0;
    color: #63001f;
    font-family: 'Instrument serif', serif;
    font-size: 1.8rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .search-close {
    background: rgba(99, 0, 31, 0.1);
    border: none;
    font-size: 1.5rem;
    color: #63001f;
    cursor: pointer;
    padding: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.3s ease;
    font-weight: 300;
  }

  .search-close:hover {
    background: rgba(99, 0, 31, 0.2);
    transform: rotate(90deg);
  }

  .search-popup-form {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    gap: 1.5rem;
  }

  .search-popup-input {
    width: 100%;
    padding: 1.2rem 1.5rem;
    border: 1px solid rgba(99, 0, 31, 0.1);
    border-radius: 15px;
    font-size: 1.1rem;
    outline: none;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.8);
    font-family: 'Inter', sans-serif;
    color: #333;
  }

  .search-popup-input:focus {
    border-color: #63001f;
    background: rgba(255, 255, 255, 1);
  }

  .search-popup-input::placeholder {
    color: rgba(99, 0, 31, 0.5);
    font-weight: 400;
  }

  .search-popup-submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    gap: 4rem;
    overflow: hidden;
    background-color: #63001f;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    cursor: pointer;
    position: relative;
  }

  .search-popup-submit-text {
    margin-right: 1rem;
    padding-left: 1rem;
    color: #ffffff;
  }

  .search-popup-submit-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
    background: #ffffff;
  }

  .search-popup-submit-cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
    fill: #63001f;
  }

  .search-popup-submit-cta .search-popup-submit-cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .search-popup-submit:hover {
    background-color: #ffffff;
    color: #63001f;
  }

  .search-popup-submit:hover .search-popup-submit-text {
    color: #63001f;
  }

  .search-popup-submit:hover .search-popup-submit-cta {
    background: #63001f;
  }

  .search-popup-submit:hover .search-popup-submit-cta .search-popup-submit-cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .search-popup-submit:hover .search-popup-submit-cta .search-popup-submit-cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .search-popup-submit:hover .search-popup-submit-cta-icon {
    fill: #ffffff;
  }

  @media (max-width: 480px) {
    .search-popup-content {
      margin: 1rem;
      width: calc(100% - 2rem);
      max-width: none;
    }

    .search-popup-header {
      padding: 1rem 1.5rem 1rem;
    }

    .search-popup-header h3 {
      font-size: 1.5rem;
    }

    .search-popup-form {
      padding: 1.2rem;
      gap: 1.2rem;
    }

    .search-popup-input {
      padding: 1rem 1.2rem;
      font-size: 1rem;
    }

    .search-popup-submit {
      width: 100%;
      gap: 2rem;
      font-size: 0.75rem;
    }

    .search-popup-submit-text {
      margin-right: 0;
      padding-left: 0.5rem;
    }

    .search-popup-submit-cta {
      width: 2.4rem;
      height: 2.4rem;
    }

    .search-popup-submit-cta-icon {
      width: 12px;
      height: 8px;
    }

    .search-close {
      width: 35px;
      height: 35px;
      font-size: 1.3rem;
    }
  }
</style>

