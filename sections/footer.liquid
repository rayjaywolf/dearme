<footer class="custom-footer">
  <div class="footer-content">
    <div class="footer-links-row">
      <div class="footer-links-col">
        <div class="footer-links-title">Quick Links</div>
        <a href="#" class="footer-links-link" id="search-trigger">Search</a>
        {% assign footer_menu = linklists.footer.links %}
        {% for link in footer_menu %}
          <a href="{{ link.url }}" class="footer-links-link">{{ link.title }}</a>
        {% endfor %}
      </div>
      <div class="footer-links-col">
        <div class="footer-links-title">Policies</div>
        {% assign quick_links_menu = linklists['quick-links'].links %}
        {% for link in quick_links_menu %}
          <a href="{{ link.url }}" class="footer-links-link">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>

    <div class="footer-logo-col">
      <img
        src="{{ 'Dear-Me-clmlmopy.png' | asset_url }}"
        alt="Footer Logo"
        class="footer-logo"
        width="100"
        height="100"
      >
    </div>
    <div class="footer-newsletter-col">
      <div class="footer-newsletter-title">
        Join Dear Me community to get exclusive access to product pre-launches, behind the scenes content, and special
        community-only offers.
      </div>
      <form class="footer-newsletter-form" autocomplete="off">
        <input
          type="email"
          placeholder="Email address"
          name="email"
          required
        >
        <button type="submit">→</button>
      </form>
      <div class="footer-social-row">
        <a
          href="https://www.instagram.com/dearme.in?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw=="
          aria-label="Instagram"
          class="footer-social-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="{{ 'instagram.svg' | asset_url }}"
            alt="Instagram"
            class="footer-social-img footer-social-img-instagram"
            width="28"
            height="28"
          >
        </a>
        <a
          href="https://www.facebook.com/dearme.in/"
          aria-label="Facebook"
          class="footer-social-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="footer-social-icon footer-social-icon-facebook"
            width="28"
            height="28"
            aria-hidden="true"
            focusable="false"
          >
            <use xlink:href="#icon-facebook"></use>
          </svg>
        </a>
        <a
          href="https://youtube.com/@dearmeconsciousayurveda?si=KnJCQn1IxJlRVE7z"
          aria-label="YouTube"
          class="footer-social-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="{{ 'youtube.svg' | asset_url }}"
            alt="YouTube"
            class="footer-social-img footer-social-img-youtube"
            width="28"
            height="28"
          >
        </a>
        <a
          href="https://wa.me/919669820089"
          aria-label="WhatsApp"
          class="footer-social-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="footer-social-icon footer-social-icon-whatsapp"
            width="28"
            height="28"
            aria-hidden="true"
            focusable="false"
          >
            <use xlink:href="#icon-whatsapp"></use>
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div class="footer-copyright">© 2025 Dear Me. All rights reserved.</div>
</footer>

<!-- Search Popup -->
<div id="search-popup" class="search-popup" style="display: none;">
  <div class="search-popup-content">
    <div class="search-popup-header">
      <h3>Search the site</h3>
      <button id="search-close" class="search-close">&times;</button>
