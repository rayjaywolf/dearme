<style>
  .testimonials-section {
    background: #fef9f2;
    padding: 4rem 0;
    height: 100%;
  }

  .testimonials-section__container {
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  .testimonials-section__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .testimonials-section__subtitle {
    font-size: 0.9rem;
    text-transform: uppercase;
    color: #63001f;
    margin-bottom: 0.75rem;
    letter-spacing: 0.1em;
  }

  .testimonials-section__description {
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    width: 45%;
    margin: 1.2rem auto 0;
    color: #63001f;
    letter-spacing: 0.1em;
  }

  .testimonials-section__title {
    font-family: 'Instrument Serif', sans-serif;
    font-size: 3rem;
    font-weight: 400;
    color: #63001f;
  }

  .testimonials-section__swiper {
    border-radius: 8px;
    position: relative;
    padding-left: 4rem;
    padding-right: 4rem;
  }

  .swiper-wrapper {
    display: flex;
  }

  .testimonials-section__card {
    background: transparent;
    border: none;
    border-radius: 16px;
    width: 100%;
    min-width: 0;
    cursor: grab;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .testimonials-section__card:active {
    cursor: grabbing;
  }

  .testimonials-section__stars {
    display: flex;
    margin-bottom: 1rem;
    justify-content: center;
  }

  .testimonials-section__star {
    color: #ff6b35;
    font-size: 1.75rem;
    margin-right: 2px;
    margin-bottom: 1rem;
  }

  .testimonials-section__text {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.4;
    color: #444;
    margin-bottom: 2rem;
    width: 60%;
  }

  .testimonials-section__author {
    font-size: 1.2rem;
    color: #666;
    font-weight: 400;
  }

  .swiper-pagination {
    position: relative;
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .swiper-pagination-bullet {
    width: 12px;
    height: 6px;
    background-color: #adaeb3;
    opacity: 1;
    border-radius: 10px;
    transition: all 0.3s ease;
    margin: 0 2px;
  }

  .swiper-pagination-bullet-active {
    width: 45px;
    border-radius: 10px;
    background-color: #63001f;
  }

  @media (max-width: 1024px) {
    .testimonials-section__swiper {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  @media (max-width: 768px) {
    .testimonials-section {
      padding: 4rem 0;
    }

    .testimonials-section__container {
      padding: 0 1rem;
    }

    .testimonials-section__title {
      font-size: 2.2rem;
    }

    .testimonials-section__subtitle {
      font-size: 1rem;
    }

    .testimonials-section__swiper {
      padding-left: 0;
      padding-right: 0;
    }

    .testimonials-section__card {
      padding: 1.5rem;
      width: 100%;
      min-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .testimonials-section__title {
      font-size: 1.8rem;
    }

    .testimonials-section__card {
      padding: 1.25rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    new Swiper('.testimonials-section__swiper', {
      slidesPerView: 1,
      spaceBetween: 32,
      loop: true,
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        1024: { slidesPerView: 1 },
        768: { slidesPerView: 1 },
        0: { slidesPerView: 1 },
      },
    });
  });
</script>
