{% comment %}
  Saffron section - Video display
{% endcomment %}

<section class="saffron-section">
  <div class="saffron-container">
    <div class="saffron-video-wrapper">
      <video
        class="saffron-video"
        autoplay
        muted
        loop
        playsinline
      >
        <source src="{{ 'fieldstoface.mp4' | asset_url }}" type="video/mp4">
        Your browser does not support the video tag.
      </video>
      <div class="saffron-video-overlay"></div>
      <div class="saffron-text-overlay">
        <h3 class="saffron-subheading">
          Authentic Kashmiri Mogra Saffron : <br>
          GI Tagged, Government Approved, Glow Guaranteed.
        </h3>
        <h2 class="saffron-heading">
          From the Valleys of Kashmir <br>
          to Your Skin
        </h2>
      </div>
    </div>
  </div>
</section>

<style>
  .saffron-section {
    width: 100%;
    height: 100vh;
    display: flex;
    padding: 1rem;
    justify-content: center;
    align-items: center;
    background: #fef9f2 url('{{ "noise.png" | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
    position: relative;
    overflow: hidden;
  }

  .saffron-container {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .saffron-video-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .saffron-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 16px;
  }

  .saffron-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 16px;
    z-index: 5;
  }

  .saffron-text-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 10;
    width: 100%;
    padding: 2rem;
  }

  .saffron-subheading {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 1rem 0;
    letter-spacing: 0.1em;
  }

  .saffron-heading {
    font-family: 'Instrument Serif', serif;
    font-size: 48px;
    font-weight: 200;
    line-height: 1.2;
    color: #ffffff;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .saffron-section {
      height: 80vh;
    }

    .saffron-heading {
      font-size: 2rem;
    }

    .saffron-subheading {
      font-size: 0.9rem;
    }

    .saffron-text-overlay {
      max-width: 90%;
      padding: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Saffron Section",
  "settings": [
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay Video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop Video",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Saffron Section"
    }
  ]
}
{% endschema %}
