{% comment %}
  Saffron Section
{% endcomment %}
<section class="saffron-section">
  <h2 class="saffron-section__title">The Glow of S<em>affron</em></h2>
  <p class="saffron-section__subtitle">
    A heritage ingredient revered for centuries, now bottled for your daily ritual.
  </p>
  <img
    src="{{ 'saffron-plant.png' | asset_url }}"
    class="saffron-section__image"
    alt="Saffron Plant"
    width="800"
    height="600"
  >
</section>

<style>
  .saffron-section {
    height: 90vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #fef9f2 url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
  }
  .saffron-section__title {
    font-family: 'Instrument Serif', serif;
    font-weight: 200;
    font-size: 3rem;
    line-height: 1.2;
    overflow: hidden;
    text-align: center;
    color: #63001f;
    margin-bottom: 1rem;
  }
  .saffron-section__title em {
    font-style: italic;
  }
  .saffron-section__image {
    width: 600px;
    height: auto;
    display: block;
    margin: 0 auto;
    margin-top: 1.75rem;
  }
  .saffron-section__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    color: #63001f;
    line-height: 1.6;
    font-weight: 500;
    margin-bottom: 2rem;
    text-align: center;
    max-width: 600px;
    padding: 0 2rem;
  }

  @media screen and (max-width: 480px) {
    .saffron-section {
      height: 60vh;
      padding: 1.5rem 0.75rem;
    }

    .saffron-section__title {
      font-size: 32px;
      margin-bottom: 0.6rem;
      line-height: 1.05;
    }

    .saffron-section__subtitle {
      width: 90%;
      font-size: 12px;
      margin-bottom: 1.2rem;
      padding: 0 0.5rem;
      line-height: 1.4;
    }

    .saffron-section__image {
      max-width: 320px;
      margin-top: 2.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Saffron",
  "presets": [{ "name": "Saffron" }]
}
{% endschema %}
