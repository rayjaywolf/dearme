{%- liquid
  assign headline_font = section.settings.headline_font
  assign subheadline_font = section.settings.subheadline_font
  assign button_font = section.settings.button_font
-%}

<style>
  {{ headline_font | font_face }}
  {{ subheadline_font | font_face }}
  {{ button_font | font_face }}

  #shopify-section-{{ section.id }} .hero-section {
    background: {{ section.settings.background_color }} url('{{ "noise.png" | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
  }

  #shopify-section-{{ section.id }} .hero-section__overlay {
    background-color: {{ section.settings.overlay_color | color_modify: 'alpha', section.settings.overlay_opacity }};
  }

  #shopify-section-{{ section.id }} .hero-section__headline {
    font-family: {{ headline_font.family }}, {{ headline_font.fallback_families }};
    font-weight: {{ headline_font.weight }};
    font-style: {{ headline_font.style }};
    font-size: {{ section.settings.headline_font_size }}rem;
    color: {{ section.settings.headline_color }};
    text-transform: {{ section.settings.headline_text_transform }};
  }

  #shopify-section-{{ section.id }} .hero-section__headline em {
    font-family: {{ headline_font.family }}, {{ headline_font.fallback_families }} !important;
    font-style: italic !important;
  }

  #shopify-section-{{ section.id }} .hero-section__subheadline {
    font-family: {{ subheadline_font.family }}, {{ subheadline_font.fallback_families }};
    font-weight: {{ subheadline_font.weight }};
    font-style: {{ subheadline_font.style }};
    font-size: {{ section.settings.subheadline_font_size }}rem;
    color: {{ section.settings.subheadline_color }};
    text-transform: {{ section.settings.subheadline_text_transform }};
  }

  #shopify-section-{{ section.id }} .hero-section__button {
    font-family: {{ button_font.family }}, {{ button_font.fallback_families }};
    font-weight: {{ button_font.weight }};
    font-style: {{ button_font.style }};
    font-size: {{ section.settings.button_font_size }}rem;
    background-color: {{ section.settings.button_bg }};
    text-transform: {{ section.settings.button_text_transform }};
  }

  #shopify-section-{{ section.id }} .hero-section__button-text {
    color: {{ section.settings.button_text_color }};
  }

  #shopify-section-{{ section.id }} .hero-section__cta {
    background: {{ section.settings.button_arrow_circle_bg }};
  }

  #shopify-section-{{ section.id }} .hero-section__cta-icon {
    fill: {{ section.settings.button_arrow_color }};
  }

  #shopify-section-{{ section.id }} .hero-section__button:hover {
    background-color: {{ section.settings.button_bg_hover }};
  }

  #shopify-section-{{ section.id }} .hero-section__button:hover .hero-section__button-text {
    color: {{ section.settings.button_text_hover_color }};
  }

  #shopify-section-{{ section.id }} .hero-section__button:hover .hero-section__cta {
    background: {{ section.settings.button_arrow_circle_bg_hover }};
  }

  #shopify-section-{{ section.id }} .hero-section__button:hover .hero-section__cta-icon {
    fill: {{ section.settings.button_arrow_hover_color }};
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .hero-section__headline {
      font-size: {{ section.settings.headline_font_size_mobile }}rem !important;
    }

    #shopify-section-{{ section.id }} .hero-section__subheadline {
      font-size: {{ section.settings.subheadline_font_size_mobile }}rem !important;
    }

    #shopify-section-{{ section.id }} .hero-section__button {
      font-size: {{ section.settings.button_font_size_mobile }}rem !important;
    }
  }
</style>

<section class="hero-section">
  <div class="hero-section__background">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}
    {%- else -%}
      <img src="{{ 'hero.jpg' | asset_url }}" alt="Hero background" width="1920" height="1080">
    {%- endif -%}
  </div>
  <div class="hero-section__overlay"></div>
  <div class="hero-section__content">
    <div class="hero-section__headline" data-split="heading">
      {%- if section.settings.headline_text != blank -%}
        {{ section.settings.headline_text }}
      {%- else -%}
        <span> One <em>Serum</em>. Every <em>Benefit</em>.</span>
        <br>
      {%- endif -%}
    </div>
    <div class="hero-section__subheadline" data-split="subheading">
      {{ section.settings.subheadline_text | default: 'To illuminate, to repair, to renew.' }}
    </div>
    <a href="{{ section.settings.button_link | default: '/products/sacredsecret' }}" class="hero-section__button">
      <span class="hero-section__button-text">{{ section.settings.button_text | default: 'Reveal my glow' }}</span>
      <div class="hero-section__cta">
        <svg
          class="hero-section__cta-icon"
          width="13"
          height="8"
          viewBox="0 0 13 8"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z">
          </path>
        </svg>
        <svg
          class="hero-section__cta-icon"
          width="13"
          height="8"
          viewBox="0 0 13 8"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z">
          </path>
        </svg>
      </div>
    </a>
  </div>
</section>

{% stylesheet %}
  .hero-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
    padding: 4rem 2rem;
    position: relative;
    will-change: transform;
  }

  .hero-section__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero-section__background video,
  .hero-section__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-section__background video {
    position: absolute;
    top: 0;
    left: 0;
  }

  .hero-section__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .hero-section__content {
    z-index: 3;
    max-width: 100%;
    margin: 0 auto;
  }

  .hero-section__headline {
    margin-bottom: 1.2rem;
    position: absolute;
    bottom: 22%;
    transform: translateX(-50%);
    left: 50%;
    width: 100%;
    line-height: 1.1;
  }

  .hero-section__headline em {
    text-transform: none !important;
  }

  .hero-section__headline .line,
  .hero-section__subheadline .line {
    display: block;
    will-change: transform;
    overflow: hidden;
  }

  .hero-section__headline .word,
  .hero-section__subheadline .word {
    display: inline-block;
  }

  .hero-section__headline .letter,
  .hero-section__subheadline .letter {
    display: inline-block;
  }

  .hero-section__subheadline {
    margin: auto;
    margin-bottom: 2rem;
    position: absolute;
    bottom: 16%;
    transform: translateX(-50%);
    left: 50%;
  }

  .hero-section__headline p,
  .hero-section__subheadline p {
    margin: 0;
    padding: 0;
  }

  .hero-section__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    text-decoration: none;
    border-radius: 999px;
    transition: background-color 0.3s ease;
    border: none;
    position: absolute;
    bottom: 9%;
    transform: translateX(-50%);
    left: 50%;
    gap: 4rem;
    overflow: hidden;
    border-color: #ffffff;
  }

  .hero-section__button-text {
    margin-right: 1rem;
    padding-left: 1rem;
  }

  .hero-section__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
  }

  .hero-section__cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
  }

  .hero-section__cta .hero-section__cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .hero-section__button:hover {
    border: none;
  }

  .hero-section__button:hover .hero-section__cta .hero-section__cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .hero-section__button:hover .hero-section__cta .hero-section__cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  @media (max-width: 480px) {
    .hero-section {
      padding: 1.5rem 0.75rem;
    }

    .hero-section__headline {
      bottom: 21%;
      width: 60%;
    }

    .hero-section__subheadline {
      bottom: 13%;
    }

    .hero-section__button {
      padding: 0.5rem 0.7rem;
      gap: 1.5rem;
      bottom: 2.5rem;
      min-width: 250px;
    }

    .hero-section__cta {
      width: 2.2rem;
      height: 2.2rem;
    }

    .hero-section__cta-icon {
      width: 10px;
      height: 6px;
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    .hero-section__headline {
      top: 14rem;
    }

    .hero-section__subheadline {
      top: 20rem;
    }

    .hero-section__button {
      bottom: 4rem;
    }
  }

  @media (max-width: 768px) {
    .hero-section__headline,
    .hero-section__subheadline,
    .hero-section__button {
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }

    .hero-section__background video {
      object-fit: cover;
      object-position: center;
    }
  }
{% endstylesheet %}

