{% comment %}
  Ingredients section
{% endcomment %}

<section
  class="ingredients-section"
  style="background: {{ section.settings.background_color }} url('{{ "noise.png" | asset_url }}'); background-size: 150px 150px; background-repeat: repeat;"
>
  <div class="ingredients-container">
    <div class="ingredients-three-columns">
      <!-- Left Column: Skin Concerns -->
      <div class="ingredients-column ingredients-column-left">
        <h3 class="skin-concerns-subheading">
          From redness to dullness, Sacred Secret is designed to address sensitive skin's top struggles without
          irritation.
        </h3>
        <div class="skin-concerns-list">
          <div class="concern-item">
            <div class="concern-problem">Dullness</div>
            <div class="concern-arrow" aria-hidden="true">↓</div>
            <div class="concern-solution">Brightened with Saffron + Rice Water</div>
          </div>
          <div class="concern-item">
            <div class="concern-problem">Redness/Irritation</div>
            <div class="concern-arrow" aria-hidden="true">↓</div>
            <div class="concern-solution">Calmed with Centella + Panthenol</div>
          </div>
          <div class="concern-item">
            <div class="concern-problem">Weak Barrier</div>
            <div class="concern-arrow" aria-hidden="true">↓</div>
            <div class="concern-solution">Strengthened with Niacinamide + Bifida Ferment</div>
          </div>
          <div class="concern-item">
            <div class="concern-problem">Dehydration</div>
            <div class="concern-arrow" aria-hidden="true">↓</div>
            <div class="concern-solution">Plumped with Low-MW Hyaluronic Acid + Propanediol</div>
          </div>
        </div>
      </div>

      <!-- Center Column: Product Image -->
      <div class="ingredients-column ingredients-column-center">
        <img
          src="{{ 'bottle.png' | asset_url }}"
          alt="Sacred Secret Bottle"
          class="ingredients-image"
          loading="lazy"
          width="300"
          height="300"
        >
      </div>

      <!-- Right Column: Product Info -->
      <div class="ingredients-column ingredients-column-right">
        <h2 class="product-showcase__title">Sacred <span>Secret</span></h2>
        <h3 class="product-showcase__subtitle">Age Defying Illuminating Saffron Weightless Face Serum</h3>
        <p class="product-showcase__description">
          Your Pathway to Timeless Beauty. Immerse in the Elixir of Kashmiri Saffron, Crafted for Royalty. Embrace
          Radiance.
        </p>
        <div class="product-showcase__buttons">
          <a
            href=""
            class="product-showcase__button"
            style=""
          >
            <span style="">Buy Now</span>
            <div class="intro__cta-arrow" style="">
              <svg
                class="icon-arrow"
                width="13"
                height="8"
                viewBox="0 0 13 8"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                style=""
              >
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
              <svg
                class="icon-arrow"
                width="13"
                height="8"
                viewBox="0 0 13 8"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                style="fill: {{ section.settings.button_arrow_color }};"
              >
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ingredients-section {
    height: 100%;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    background-color: #ead1c1 !important;
    padding: 4rem 3rem 4rem;
  }

  .ingredients-container {
    text-align: center;
  }

  .ingredients-title {
    font-weight: 200;
    font-size: 3rem;
    line-height: 1.2;
    margin-bottom: 3rem;
    overflow: hidden;
  }

  .ingredients-description {
    text-align: left;
    font-size: 0.8rem;
    width: 100%;
    overflow: hidden;
    grid-column: 1;
  }

  .ingredients-three-columns {
    display: grid;
    align-items: center;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .ingredients-column {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .ingredients-column-left {
    align-items: flex-start;
    text-align: left;
  }

  .ingredients-column-center {
    align-items: center;
  }

  .ingredients-column-right {
    align-items: center;
    text-align: center;
  }

  .skin-concerns-subheading {
    font-size: 14px;
    color: #444;
    margin: 0 0 4rem 0;
    line-height: 1.5;
    text-transform: none;
    letter-spacing: 0.01em;
    font-weight: 400;
    max-width: 420px;
    text-align: center;
  }

  .skin-concerns-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 2rem;
    width: 100%;
  }

  .concern-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-align: center;
  }

  .concern-arrow {
    font-size: 16px;
    color: #63001f;
    letter-spacing: 0.1em;
  }

  .concern-problem {
    font-family: 'Instrument Serif', serif;
    font-size: 22px;
    font-weight: 400;
    color: #63001f;
    letter-spacing: 0.01em;
  }

  .concern-solution {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #444;
    line-height: 1.65;
    letter-spacing: 0.02em;
    max-width: 360px;
    /* text-transform: uppercase; */
  }

  .product-showcase__title {
    font-family: 'Instrument Serif', serif;
    font-weight: 200;
    font-size: 3rem;
    margin: 0 0 2rem 0;
    line-height: 0.9;
    color: #63001f;
    text-align: center;
    text-transform: capitalize;
    span {
      font-style: italic;
    }
  }

  .product-showcase__subtitle {
    font-weight: 400;
    font-size: 1.2rem;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    line-height: 1.4;
    width: 100%;
    color: #63001f;
    text-align: center;
  }

  .product-showcase__description {
    font-family: 'Inter', serif;
    font-size: 14px;
    line-height: 1.4;
    margin: 0 0 3rem 0;
    max-width: 100%;
    color: #444;
    text-align: center;
  }

  .ingredients-image {
    max-width: 85%;
    height: auto;
    display: block;
    margin: 0 auto;
    margin-left: 90px;
    grid-column: 1;
  }

  .ingredients-image-container > div:last-child {
    grid-column: 2;
  }

  .product-showcase__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    opacity: 1;
    align-items: center;
    justify-content: center;
  }

  .product-showcase__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    background-color: #ffffff;
    color: #63001f;
    border: none;
    gap: 1rem;
    overflow: hidden;
    max-width: 220px;
  }

  .product-showcase__button span {
    margin-right: 3rem;
    padding-left: 1rem;
    color: #63001f;
  }

  .intro__cta-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    background: #63001f;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
  }

  .icon-arrow {
    width: 15px;
    height: 10px;
    fill: #ffffff;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
  }

  .intro__cta-arrow .icon-arrow:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .product-showcase__button:hover .intro__cta-arrow .icon-arrow:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .product-showcase__button:hover .intro__cta-arrow .icon-arrow:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .product-showcase__button:hover {
    background-color: #63001f !important;
    color: #ffffff !important;
    border: none !important;
  }

  .product-showcase__button:hover span {
    color: #ffffff !important;
  }

  .product-showcase__button:hover .intro__cta-arrow {
    background: #ffffff !important;
  }

  .product-showcase__button:hover .icon-arrow {
    fill: #63001f !important;
  }

  @media screen and (max-width: 768px) {
    .ingredients-title {
      font-size: 2.5rem;
    }

    .ingredients-three-columns {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .ingredients-column-left,
    .ingredients-column-right {
      align-items: center;
      text-align: center;
    }

    .ingredients-image {
      max-width: 60%;
    }

    .skin-concerns-list {
      gap: 1rem;
    }

    .concern-item {
      text-align: center;
    }

    .concern-problem {
      font-size: 20px;
    }

    .concern-solution {
      font-size: 13px;
      margin: 0 auto;
    }
  }
</style>

