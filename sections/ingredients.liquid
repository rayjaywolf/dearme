<section
  class="ingredients-section"
  style="--section-bg: {{ section.settings.section_bg }};"
>
  <div class="ingredients-section__container">
    <div class="ingredients-section__columns">
      <div class="ingredients-section__column ingredients-section__column--left">
        <div class="ingredients-section__row ingredients-section__row--top">
          <div class="ingredients-section__text">
            {%- if section.settings.subheading != blank -%}
              <h3
                class="ingredients-section__subheading"
                style="
                  --text-color: {{ section.settings.text_color }};
                  --subheading-font-size: {{ section.settings.subheading_font_size }}rem;
                  --subheading-font-weight: {{ section.settings.subheading_font_weight }};
                  --subheading-text-transform: {{ section.settings.subheading_text_transform }};
                "
              >
                {{ section.settings.subheading | escape }}
              </h3>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <div
                class="ingredients-section__heading"
                style="
                  --text-color: {{ section.settings.text_color }};
                  --heading-font-size: {{ section.settings.heading_font_size }}px;
                  --heading-font-weight: {{ section.settings.heading_font_weight }};
                  --heading-text-transform: {{ section.settings.heading_text_transform }};
                "
              >
                {{ section.settings.heading }}
              </div>
            {%- endif -%}
            <button
              type="button"
              id="ingredients-modal-trigger"
              class="ingredients-section__button"
              aria-haspopup="dialog"
              aria-expanded="false"
            >
              <span class="ingredients-section__button-label">{{ section.settings.button_text }}</span>
              <div class="ingredients-section__cta">
                <svg
                  class="ingredients-section__cta-icon"
                  width="13"
                  height="8"
                  viewBox="0 0 13 8"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
                </svg>
                <svg
                  class="ingredients-section__cta-icon"
                  width="13"
                  height="8"
                  viewBox="0 0 13 8"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
                </svg>
              </div>
            </button>
            <div
              class="ingredients-section__modal"
              id="ingredients-modal"
              aria-hidden="true"
              role="dialog"
              aria-modal="true"
              aria-labelledby="ingredients-modal-title"
            >
              <div class="ingredients-section__modal-overlay" role="presentation"></div>
              <div class="ingredients-section__modal-content" role="document">
                <button type="button" class="ingredients-section__modal-close" aria-label="Close ingredients list">
                  &times;
                </button>
                <h3 class="ingredients-section__modal-title" id="ingredients-modal-title">{{ section.settings.modal_title }}</h3>
                <p class="ingredients-section__modal-body">
                  {{ section.settings.modal_body }}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="ingredients-section__column ingredients-section__column--right">
        <div class="ingredients-section__images-row">
          <div class="ingredients-section__ingredient">
            <div class="ingredients-section__ingredient-details">
              <h4 class="ingredients-section__ingredient-name">{{ section.settings.ingredient_1_name }}</h4>
              <p class="ingredients-section__ingredient-description">
                {{ section.settings.ingredient_1_description }}
              </p>
            </div>
            <div class="ingredients-section__ingredient-image-container">
              <img
                src="{{ 'ingredient-saffron.png' | asset_url }}"
                alt="{{ section.settings.ingredient_1_alt }}"
                class="ingredients-section__ingredient-image"
                loading="lazy"
              >
              <div class="ingredients-section__ingredient-badges">
                {%- if section.settings.ingredient_1_badge_1 != blank -%}
                  <div class="ingredients-section__ingredient-badge">{{ section.settings.ingredient_1_badge_1 }}</div>
                {%- endif -%}
                {%- if section.settings.ingredient_1_badge_2 != blank -%}
