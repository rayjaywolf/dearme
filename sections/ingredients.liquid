<style>
  .ingredients-section {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    background-color: var(--section-bg, #fef9f2) !important;
    background: var(--section-bg, #fef9f2) url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
  }

  .ingredients-section__container {
    width: 100%;
    margin: 0;
    padding: 2rem;
    padding-top: 4rem;
    padding-bottom: 0;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .ingredients-section__columns {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 1rem;
    width: 100%;
    height: 100%;
  }

  .ingredients-section__column {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    box-sizing: border-box;
    overflow: hidden;
  }

  .ingredients-section__column--left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .ingredients-section__row {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0rem;
  }

  .ingredients-section__text {
    text-align: left;
    max-width: 100%;
  }

  .ingredients-section__subheading {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: capitalize;
    color: #63001f;
    margin: 0 0 1rem 0;
  }

  .ingredients-section__heading {
    font-family: 'Instrument Serif', serif;
    font-size: var(--heading-font-size, 48px);
    font-weight: var(--heading-font-weight, 200);
    line-height: 1.2;
    color: var(--text-color, #63001f);
    margin: 0 0 2rem 0;
    text-align: left;
    text-transform: var(--heading-text-transform, none);
  }

  .ingredients-section__heading p {
    margin: 0;
  }

  .ingredients-section__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    gap: 4rem;
    overflow: hidden;
    max-width: 300px;
    margin-top: 2rem;
    cursor: pointer;
    background-color: #63001f;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-style: normal;
  }

  .ingredients-section__button .ingredients-section__button-label {
    color: #ffffff;
  }
  .ingredients-section__button .ingredients-section__cta {
    background: #ffffff;
  }
  .ingredients-section__button .ingredients-section__cta-icon {
    fill: #63001f;
  }
  .ingredients-section__button:hover {
    background-color: #ffffff;
    color: #63001f;
    border: none;
  }
  .ingredients-section__button:hover .ingredients-section__button-label {
    color: #63001f;
  }
  .ingredients-section__button:hover .ingredients-section__cta {
    background: #63001f;
  }
  .ingredients-section__button:hover .ingredients-section__cta-icon {
    fill: #ffffff;
  }

  .ingredients-section__button-label {
    margin-right: 1rem;
    padding-left: 1rem;
  }

  .ingredients-section__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
  }

  .ingredients-section__cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
  }

  .ingredients-section__cta .ingredients-section__cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .ingredients-section__button:hover .ingredients-section__cta .ingredients-section__cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .ingredients-section__button:hover .ingredients-section__cta .ingredients-section__cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .ingredients-section__modal {
    position: fixed;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .ingredients-section__modal[aria-hidden='false'] {
    display: flex;
  }

  .ingredients-section__modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
  }

  .ingredients-section__modal-content {
    position: relative;
    max-width: min(90vw, 680px);
    background: #ffffff;
    border-radius: 24px;
    padding: 2rem 2.5rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.18);
    color: #2a2a2a;
    z-index: 1;
    line-height: 1.6;
    font-family: 'Inter', sans-serif;
  }

  .ingredients-section__modal-title {
    margin: 0 0 1rem 0;
    font-size: 1.4rem;
    font-weight: 600;
    color: #63001f;
  }

  .ingredients-section__modal-body {
    margin: 0;
    font-size: 0.95rem;
    color: #3f3f3f;
  }

  .ingredients-section__modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: #63001f;
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .ingredients-section__modal-close:hover {
    background: #450012;
  }

  @media screen and (max-width: 768px) {
    .ingredients-section__modal-content {
      padding: 1.5rem;
      border-radius: 18px;
    }

    .ingredients-section__modal-title {
      font-size: 1.2rem;
    }

    .ingredients-section__modal-body {
      font-size: 0.9rem;
    }
  }

  .ingredients-section__column--right {
    overflow: hidden;
    max-width: 100%;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0;
  }

  .ingredients-section__images-row {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    width: 100%;
    max-width: 100%;
    scrollbar-width: none;
    -ms-overflow-style: none;
    box-sizing: border-box;
  }

  .ingredients-section__images-row::-webkit-scrollbar {
    display: none;
  }

  .ingredients-section__ingredient {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    width: 420px;
  }

  .ingredients-section__ingredient-name {
    font-family: 'Instrument Serif', serif;
    font-size: 40px;
    font-weight: 400;
    color: #63001f;
    margin: 0 0 1rem 0;
    text-align: left;
    line-height: 1;
  }

  .ingredients-section__ingredient-description {
    font-size: 14px;
    color: #444;
    margin: 0;
    text-align: left;
    line-height: 1.7;
  }

  .ingredients-section__ingredient-image-container {
    position: relative;
    width: 420px;
    height: 312px;
    margin-top: 2rem;
  }

  .ingredients-section__ingredient-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    flex-shrink: 0;
  }

  .ingredients-section__ingredient-badges {
    position: absolute;
    bottom: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: calc(100% - 32px);
  }

  .ingredients-section__ingredient-badge {
    background: #63001f;
    border-radius: 20px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    line-height: 1.2;
    white-space: nowrap;
    text-align: center;
  }

  @media screen and (max-width: 480px) {
    .ingredients-section__container {
      padding: 2rem 1rem 1rem;
      padding-right: 0;
    }

    .ingredients-section__columns {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .ingredients-section__column {
      padding: 0rem;
    }

    .ingredients-section__column--right {
      padding: 0;
    }

    .ingredients-section__heading {
      font-size: 1.8rem;
    }

    .ingredients-section__subheading {
      font-size: var(--subheading-font-size, 0.8rem);
      margin-bottom: 0.8rem;
    }

    .ingredients-section__button {
      max-width: 250px;
      font-size: 0.7rem;
      padding: 0.4rem 0.4rem;
      gap: 2rem;
      margin-top: 1.5rem;
    }

    .ingredients-section__button-label {
      margin-right: 0.8rem;
