{% comment %}
This section is used in the product template to render product page with
media, content, and add-to-cart form.

https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_media = current_variant.featured_media | default: product.featured_media %}

<section class="product-section">
  <div class="product-section__body">
    <div class="product-section__gallery" id="ProductGallery-{{ section.id }}" data-product-gallery>
      {% if product.media.size > 0 %}
      <div class="product-gallery">
        <div class="product-gallery__main" data-gallery-main>
          {% for media in product.media %}
          <div
            class="product-gallery__slide{% if featured_media and media.id == featured_media.id %} product-gallery__slide--active{% elsif featured_media == blank and forloop.first %} product-gallery__slide--active{% endif %}"
            data-gallery-slide data-media-id="{{ media.id }}">
            {% case media.media_type %}
            {% when 'image' %}
            {{ media | image_url: width: 1600 | image_tag: loading: 'eager', class: 'product-section__media-img', alt:
            media.alt | default: product.title }}
            {% when 'video', 'external_video', 'model' %}
            {{ media | media_tag: class: 'product-section__media-media' }}
            {% else %}
            {{ media | media_tag: class: 'product-section__media-media' }}
            {% endcase %}
          </div>
          {% endfor %}
        </div>


        {% if product.media.size > 1 %}
        <div class="product-gallery__thumbs" role="list" data-gallery-thumbs>
          {% for media in product.media %}
          {% assign media_is_active = false %}
          {% if featured_media and media.id == featured_media.id %}
          {% assign media_is_active = true %}
          {% elsif featured_media == blank and forloop.first %}
          {% assign media_is_active = true %}
          {% endif %}
          <button type="button"
            class="product-gallery__thumb{% if media_is_active %} product-gallery__thumb--active{% endif %}"
            data-gallery-thumb data-target="{{ media.id }}"
            aria-pressed="{% if media_is_active %}true{% else %}false{% endif %}"
            aria-label="{{ media.alt | default: product.title }}">
            {% if media.media_type == 'image' %}
            {{ media | image_url: width: 220 | image_tag: loading: 'lazy', class: 'product-gallery__thumb-image', alt:
            media.alt | default: product.title }}
            {% elsif media.preview_image %}
            {{ media.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', class:
            'product-gallery__thumb-image', alt: media.preview_image.alt | default: product.title }}
            {% endif %}
          </button>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}
    </div>

    <div class="product-section__details">
      <p class="product-section__subtitle">Illuminating Saffron Serum</p>
      <h1 class="product-section__title">{{ product.title }}</h1>
      <p class="product-section__tagline">Infused with Dear Me's Innovation: <strong>Saffrux Brightening Engine™
        </strong> & <strong> BarrierBiome
          Complex™ </strong> • Suitable for Sensitive & Acne Prone Skin • 11 Ayurvedic Extracts • 5 Clinical Actives</p>
      <p class="product-section__mission"><strong>To illuminate. To repair. To renew.</strong></p>
      <p class="product-section__intro">A singular formula that replaces the complexity of layering. Infused with 11
        ancient botanicals and 5 modern actives, it refines, hydrates, brightens, and renews - restoring skin's natural
        equilibrium in just one intelligent step.</p>

      {% form 'product', product, class: 'product-section__purchase-form' %}
      {% if product.has_only_default_variant == false %}
      {% for option in product.options_with_values %}
      <div class="product-section__form-field">
        <label for="Option-{{ section.id }}-{{ forloop.index0 }}" class="product-section__form-label">{{ option.name
          }}</label>
        <div class="product-section__select-wrapper">
          <select id="Option-{{ section.id }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]"
            class="product-section__select" data-option-index="{{ forloop.index0 }}">
            {% for value in option.values %}
            <option value="{{ value | escape }}" {% if option.selected_value==value %}selected="selected" {% endif %}>
              {{ value }}
            </option>
            {% endfor %}
          </select>
        </div>
      </div>
      {% endfor %}

      <select name="id" id="VariantSelector-{{ section.id }}" class="product-section__variant-id"
        style="display: none;">
        {% for variant in product.variants %}
        <option value="{{ variant.id }}" {% if variant.id==current_variant.id %}selected="selected" {% endif %}>
          {{ variant.title }}
        </option>
        {% endfor %}
      </select>
      {% else %}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% endif %}

      <div class="product-section__price-block">
        <span class="product-section__price">{{ current_variant.price | money }}</span>
        {% if current_variant.compare_at_price > current_variant.price %}
        <span class="product-section__price-compare">{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
        {% if current_variant.available %}
        <span class="product-section__stock product-section__stock--available">In stock</span>
        {% else %}
        <span class="product-section__stock product-section__stock--soldout">Sold out</span>
        {% endif %}
      </div>

      <input type="hidden" name="quantity" value="1">

      <div class="product-section__buttons">
        <button type="submit" class="product-section__submit product-section__submit--cart" {% unless
          current_variant.available %}disabled{% endunless %}>
          <span class="product-section__button-text">Buy Now</span>
          <div class="product-section__cta">
            <svg class="product-section__cta-icon" width="13" height="8" viewBox="0 0 13 8" fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z">
              </path>
            </svg>
            <svg class="product-section__cta-icon" width="13" height="8" viewBox="0 0 13 8" fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path
                d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z">
              </path>
            </svg>
          </div>
        </button>

        {% if section.settings.enable_payment_button %}
  {{ form | payment_button }}
{% endif %}
      </div>
      {% endform %}

      <div class="product-section__accordion">
        <div class="product-section__accordion-item" id="get-to-know-me">
          <button type="button" class="product-section__accordion-header">
            <span class="product-section__accordion-title">GET TO KNOW ME</span>
            <span class="product-section__accordion-icon">+</span>
          </button>
          <div class="product-section__accordion-panel">
            <p>Dear Me Sacred Secret Serum 2.0 is a next-generation Ayurvedic treatment engineered for modern skin.
              Powered by the Saffrux Brightening Engine™ and BarrierBiome Complex™, it unites eleven time-honoured
              botanicals with five clinically validated actives to deliver luminous clarity and deep dermal resilience.
              Saffron, Licorice, and Turmeric restore brightness from within, while Niacinamide and stabilized Vitamin C
              refine tone and texture. A network of Centella, Bifida Ferment, and Panthenol rebuilds the barrier,
              restoring calm to even the most sensitive skin. Crystal-clear, oil-free, and ultra-light, it leaves the
              complexion balanced, hydrated, and quietly radiant.</p>
          </div>
        </div>

        <div class="product-section__accordion-item" id="what-to-expect">
          <button type="button" class="product-section__accordion-header">
            <span class="product-section__accordion-title">WHAT TO EXPECT FROM ME</span>
            <span class="product-section__accordion-icon">+</span>
          </button>
          <div class="product-section__accordion-panel">
            <p><strong>1. Visible Radiance</strong><br>
              Powered by the Saffrux Brightening Engine™, Saffron, Niacinamide, and Vitamin C work in synergy to visibly
              even tone and restore a soft, illuminated glow.</p>
            <p><strong>2. Strengthened Barrier</strong><br>
              The BarrierBiome Complex™ reinforces the skin's natural defense by restoring microbiome balance, sealing
              in moisture, and improving resilience against sensitivity.</p>
            <p><strong>3. Calm, Balanced Skin</strong><br>
              Centella, Panthenol, and Licorice soothe irritation, reduce redness, and bring lasting equilibrium to
              reactive skin.</p>
            <p><strong>4. Deep Hydration</strong><br>
              Hyaluronic Acid, Rice Water, and Birch Sap deliver multi-layered hydration, keeping the skin dewy, plump,
              and supple throughout the day.</p>
            <p><strong>5. Lightweight Clarity</strong><br>
              Crystal-clear, oil-free, and non-sticky, the serum absorbs instantly - leaving behind only comfort,
              translucence, and quiet luminosity.</p>
          </div>
        </div>

        <div class="product-section__accordion-item" id="how-to-use">
          <button type="button" class="product-section__accordion-header">
            <span class="product-section__accordion-title">HOW TO USE ME</span>
            <span class="product-section__accordion-icon">+</span>
          </button>
          <div class="product-section__accordion-panel">
            <p>After cleansing, dispense a couple of pumps and spread the serum evenly all over your face and neck.</p>
            <p>It can be used on a slightly damp face or a dry face.</p>
            <p>Never skip the sunscreen after using Sacred Secret in your AM routine, as it's packed with antioxidants.
            </p>
          </div>
        </div>

        <div class="product-section__accordion-item" id="make-the-most">
          <button type="button" class="product-section__accordion-header">
            <span class="product-section__accordion-title">MAKE THE MOST OUT OF ME</span>
            <span class="product-section__accordion-icon">+</span>
          </button>
          <div class="product-section__accordion-panel">
            <p><strong>1. Use as a Spot Treatment</strong><br>
              Got a stubborn dry patch, peeling skin, or active acne? Dab a half a pump of Sacred Secret directly onto
              the area after cleansing, and let the calming and repairing actives get to work.</p>
            <p><strong>2. De-puff and Refresh Under-Eyes</strong><br>
              Keep Sacred Secret in the fridge overnight. In the morning, apply one pump to your ring finger and gently
              pat along the orbital bone. You'll notice instantly plumper and de-puffed under-eyes.</p>
            <p><strong>3. Mix with Makeup</strong><br>
              Add a drop of Sacred Secret to your foundation, powder blush, or highlighter to create a dewy, skin-loving
              finish.</p>
            <p><strong>4. Mix with Moisturiser</strong><br>
              For an extra hydration boost, mix Sacred Secret with your moisturiser to amplify its benefits. This works
              especially well at night or during dry seasons!</p>
          </div>
        </div>

        <div class="product-section__accordion-item" id="full-ingredients-list">
          <button type="button" class="product-section__accordion-header">
            <span class="product-section__accordion-title">FULL INGREDIENTS LIST</span>
            <span class="product-section__accordion-icon">+</span>
          </button>
          <div class="product-section__accordion-panel">
            <p>Aqua(Water), Glycyrrhiza Glabra (Licorice) Root Extract, Saccharomyces/Rice Ferment Filtrate, Bifida Ferment Lysate, Betula Platyphylla Japonica Juice (Birch Sap), Propylene Glycol, Madecassic Acid, Asiaticoside, Asiatic Acid, Niacinamide, Panthenol, Propanediol, Curcuma Longa (Turmeric) Root Extract, Nelumbo Nucifera (Lotus) Flower Extract, Glycerin, Terminalia Ferdinandiana (Kakadu Plum) Fruit Extract, 3-O-Ethyl Ascorbic Acid, Betaine, Dimethyl Isosorbide, Crocus Sativus (Saffron) Stigma Extract, Sodium Hyaluronate (Hyaluronic Acid), PPG-26-Buteth-26, PEG-40 Hydrogenated Castor Oil, Ethylhexyl Methoxycinnamate, Ethylhexyl Salicylate, Butyl Methoxydibenzoylmethane, Xanthan Gum, Butylene Glycol, Potassium Sorbate, Pentylene Glycol, Polyglyceryl-6 Caprylate, Polyglyceryl-4 Caprate, Disodium EDTA, Phenoxyethanol, Ethylhexylglycerin.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="product-sticky-bar" id="product-sticky-bar" aria-hidden="true">
  <div class="product-sticky-bar__links">
    {% if product.featured_media %}
      {{ product.featured_media | image_url: width: 100 | image_tag: class: 'product-sticky-bar__image', loading: 'lazy', alt: product.title }}
    {% endif %}
    <span>{{ product.title }}</span>
  </div>
  <button type="button" class="product-sticky-bar__cta product-section__submit product-section__submit--cart">
    <span class="product-section__button-text">Buy Now &nbsp;&nbsp; | &nbsp;&nbsp; {{ current_variant.price | money }}</span>
    <div class="product-section__cta">
      <svg class="product-section__cta-icon" width="13" height="8" viewBox="0 0 13 8" fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <path
          d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z">
        </path>
      </svg>
      <svg class="product-section__cta-icon" width="13" height="8" viewBox="0 0 13 8" fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <path
          d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z">
        </path>
      </svg>
    </div>
  </button>
  
</div>

<style>
  .product-sticky-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: #fef9f2;
    border-top: 1px solid rgba(99, 0, 31, 0.15);
    transform: translateY(100%);
    transition: transform 0.3s ease;
    z-index: 1000;
  }

  .product-sticky-bar--visible {
    transform: translateY(0);
  }

  .product-sticky-bar__links {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .product-sticky-bar__links span {
    color: #63001f;
    font-family: "Instrument Serif", serif;
    font-size: 20px;
  }

  .product-sticky-bar__cta { }

  .product-sticky-bar__image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
  }

  @media (max-width: 480px) {
    .product-sticky-bar__links {
      display: none;
    }

    .product-sticky-bar__cta {
      width: 100%;
    }
  }
    
</style>

  <script>
    (function() {
      var sticky = document.getElementById('product-sticky-bar');
      if (!sticky) return;

      var sentinel = document.querySelector('.product-section__buttons');
      var preBookBtn = document.querySelector('.product-section__buttons .product-section__submit--cart');
      var form = preBookBtn ? preBookBtn.closest('form') : null;
      var mq = window.matchMedia('(max-width: 480px)');

      // Desktop/tablet: use IntersectionObserver on the buttons container
      if (sentinel && 'IntersectionObserver' in window && !mq.matches) {
        var io = new IntersectionObserver(function(entries) {
          var entry = entries[0];
          if (entry && entry.isIntersecting) {
            sticky.classList.remove('product-sticky-bar--visible');
            sticky.setAttribute('aria-hidden', 'true');
          } else {
            sticky.classList.add('product-sticky-bar--visible');
            sticky.setAttribute('aria-hidden', 'false');
          }
        }, { threshold: 0 });
        io.observe(sentinel);
      }

      // Mobile: show only after the Pre-Book button has been surpassed (scrolled above viewport top)
      function setVisible(isVisible) {
        if (isVisible) {
          sticky.classList.add('product-sticky-bar--visible');
          sticky.setAttribute('aria-hidden', 'false');
        } else {
          sticky.classList.remove('product-sticky-bar--visible');
          sticky.setAttribute('aria-hidden', 'true');
        }
      }

      var scheduled = false;
      function mobileCheck() {
        if (!mq.matches) return; // only apply on mobile
        if (!preBookBtn) return;
        var rect = preBookBtn.getBoundingClientRect();
        // Show when the top of the button has gone above the viewport (user has scrolled past it)
        var show = rect.top < 0;
        setVisible(show);
      }

      function onScroll() {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(function() {
          scheduled = false;
          mobileCheck();
        });
      }

      if (mq.matches) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', mobileCheck);
        mobileCheck();
      }

      if (typeof mq.addEventListener === 'function') {
        mq.addEventListener('change', function(e) {
          if (e.matches) {
            // entering mobile
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', mobileCheck);
            mobileCheck();
          } else {
            // leaving mobile
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('resize', mobileCheck);
            // When not on mobile, hide initially; IO (if present above) will control visibility
            setVisible(false);
          }
        });
      }

      var stickyCta = document.querySelector('.product-sticky-bar__cta');
      if (stickyCta) {
        stickyCta.addEventListener('click', function() {
          if (preBookBtn) {
            preBookBtn.click();
          } else if (form) {
            form.submit();
          }
        });
      }

      var links = document.querySelectorAll('.product-sticky-bar__links a');
      links.forEach(function(link) {
        link.addEventListener('click', function(e) {
          var href = link.getAttribute('href');
          if (href && href.startsWith('#')) {
            e.preventDefault();
            var target = document.querySelector(href);
            if (target && target.scrollIntoView) {
              try { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
              catch (err) { window.location.hash = href.substring(1); }
            }
          }
        });
      });
    })();
  </script>

