<script>
  document.addEventListener('DOMContentLoaded', function () {
    var trigger = document.getElementById('ingredients-modal-trigger');
    var modal = document.getElementById('ingredients-modal');
    if (!trigger || !modal) return;

    var closeBtn = modal.querySelector('.ingredients-section__modal-close');
    var overlay = modal.querySelector('.ingredients-section__modal-overlay');

    function openModal() {
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      trigger.setAttribute('aria-expanded', 'true');
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    }

    trigger.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
        closeModal();
      }
    });
  });
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css">

<script src="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.js" defer></script>

<script>
  const reviews = [
    {
      text: 'Within a week of regular usage everyone around me started complimenting about the glow, freshness on my skin. Awesome product!!!',
      author: 'Kriti K.',
    },
    {
      text: 'As a person who struggles with sparse acne that leaves dark spots behind, this helped to quickly get rid of those marks. I was shocked at how quickly my skin healed and brightened.',
