    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;
    color: #444;
    margin: 0;
    text-align: center;
    width: 100%;
  }

  .bv-slider-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 715px;
    height: 515px;
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .bv-slider-container.active {
    opacity: 1;
    visibility: visible;
  }

  .bv-slider-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .bv-slider-image--after {
    clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%);
    will-change: clip-path;
  }

  .bv-slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    background: rgba(255, 255, 255, 0.7);
    cursor: ew-resize;
    will-change: left;
  }

  .bv-slider-handle-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: #fef9f2;
    border: 2px solid #63001f;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(99, 0, 31, 0.15);
  }

  .bv-slider-handle-button svg {
    flex-shrink: 0;
  }

  .bv-slider-label {
    position: absolute;
    top: 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    background: rgba(254, 249, 242, 0.8);
    color: #63001f;
    border-radius: 99px;
    pointer-events: none;
  }

  .bv-slider-label--before {
    right: 1rem;
  }

  .bv-slider-label--after {
    left: 1rem;
  }

