      author: 'Gautami',
    },
    {
      text: 'I have sensitive skin and am always a bit nervous to try new products. Immediately after the first use my skin looked great and I had no reactions. Highly recommend!',
      author: 'Twinkle',
    },
    {
      text: "It's like magic in a bottle ✨",
      author: 'Muskan S.',
    },
  ];

  function renderReviews() {
    const container = document.getElementById('reviews-container');
    if (!container) return;

    const reviewsHTML = reviews
      .map(
        (review) => `
      <div class="keen-slider__slide">
        <div class="reviews-section__shape-container">
          <div class="reviews-section__inverted">
            <div class="reviews-section__quotes"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M8.09 11.6314H3.4C3.48 6.96144 4.4 6.19144 7.27 4.49144C7.6 4.29144 7.71 3.87144 7.51 3.53144C7.32 3.20144 6.89 3.09144 6.56 3.29144C3.18 5.29144 2 6.51144 2 12.3214V17.7114C2 19.4214 3.39 20.8014 5.09 20.8014H8.09C9.85 20.8014 11.18 19.4714 11.18 17.7114V14.7114C11.18 12.9614 9.85 11.6314 8.09 11.6314Z" fill="#63001f"></path> <path d="M18.9086 11.6314H14.2186C14.2986 6.96144 15.2186 6.19144 18.0886 4.49144C18.4186 4.29144 18.5286 3.87144 18.3286 3.53144C18.1286 3.20144 17.7086 3.09144 17.3686 3.29144C13.9886 5.29144 12.8086 6.51144 12.8086 12.3314V17.7214C12.8086 19.4314 14.1986 20.8114 15.8986 20.8114H18.8986C20.6586 20.8114 21.9886 19.4814 21.9886 17.7214V14.7214C21.9986 12.9614 20.6686 11.6314 18.9086 11.6314Z" fill="#63001f"></path> </g></svg></div>
            <div class="reviews-section__stars">★★★★★</div>
            <span class="reviews-section__shape-text">${review.text}</span>
          </div>
          <span class="reviews-section__signature-text">- ${review.author}</span>
        </div>
      </div>
    `
      )
      .join('');

    container.innerHTML = reviewsHTML;
  }

  function initializeSlider() {
    const sliderElement = document.getElementById('reviews-slider');
    if (!sliderElement) return;

    const autoplayPlugin = (slider) => {
      let timeout;
      let mouseOver = false;

      function clearNextTimeout() {
        clearTimeout(timeout);
      }

      function nextTimeout() {
        clearNextTimeout();
        if (mouseOver) return;
        timeout = setTimeout(() => {
          slider.next();
        }, 3000);
      }

      slider.on('created', () => {
        slider.container.addEventListener('mouseover', () => {
          mouseOver = true;
          clearNextTimeout();
        });
        slider.container.addEventListener('mouseout', () => {
          mouseOver = false;
          nextTimeout();
        });
        nextTimeout();
      });
      slider.on('dragStarted', clearNextTimeout);
      slider.on('animationEnded', nextTimeout);
      slider.on('updated', nextTimeout);
    };

    const keenSlider = new KeenSlider(
      sliderElement,
      {
        loop: true,
        mode: 'free-snap',
        slides: {
          perView: 3,
          spacing: 10,
        },
        breakpoints: {
          '(max-width: 1024px)': {
            slides: {
              perView: 2,
              spacing: 15,
            },
          },
          '(max-width: 480px)': {
            slides: {
              perView: 1,
              spacing: 10,
            },
          },
        },
      },
      [autoplayPlugin]
    );

    const dotsContainer = document.getElementById('reviews-dots');
    if (dotsContainer) {
      const dots = keenSlider.track.details.slides.map((_, idx) => {
        const dot = document.createElement('button');
        dot.className = 'reviews-section__dot';
        dot.addEventListener('click', () => keenSlider.moveToIdx(idx));
        return dot;
      });

      dotsContainer.append(...dots);

      const updateDots = () => {
        const currentSlide = keenSlider.track.details.rel;
        dots.forEach((dot, idx) => {
          dot.classList.toggle('reviews-section__dot--active', idx === currentSlide);
        });
      };

      keenSlider.on('created', updateDots);
      keenSlider.on('slideChanged', updateDots);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderReviews();
    setTimeout(initializeSlider, 100);
  });
</script>

