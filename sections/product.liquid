    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0rem;
    margin: 0 auto;
  }

  .bv-sliders-stack {
    position: relative;
    width: 715px;
    height: 515px;
  }

  .bv-slider-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .bv-slider-nav {
    display: flex;
    gap: 1rem;
    margin-top: 32px;
  }

  .bv-slider-nav-button {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: none;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.3s ease;
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .bv-slider-nav-icon {
    width: 20px;
    height: auto;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
  }

  .bv-slider-nav-button .bv-slider-nav-icon:last-child {
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .bv-slider-nav-button--prev .bv-slider-nav-icon {
    transform: translate(-50%, -50%) scaleX(1) rotate(180deg);
  }

  .bv-slider-nav-button--prev .bv-slider-nav-icon:last-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2) rotate(180deg);
  }

  .bv-slider-nav-button:hover {
    background-color: #63001f;
  }

  .bv-slider-nav-button:hover .bv-slider-nav-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .bv-slider-nav-button:hover .bv-slider-nav-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .bv-slider-nav-button--prev:hover .bv-slider-nav-icon:first-child {
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2) rotate(180deg);
  }

  .bv-slider-nav-button--prev:hover .bv-slider-nav-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1) rotate(180deg);
  }

  .bv-slider-title {
    font-family: 'Instrument Serif', serif;
