  }

  @media screen and (max-width: 360px) {

    .innovation-card__tagline p {
      font-size: 11px;
    }

    .innovation-card__tagline-text {
      font-size: 38px !important;
    }

    .promise-card__text {
      font-size: 11px !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gallery = document.querySelector('#ProductGallery-{{ section.id }}');
    if (!gallery) return;

    const main = gallery.querySelector('[data-gallery-main]');
    const thumbsContainer = gallery.querySelector('[data-gallery-thumbs]');
    const slides = [...gallery.querySelectorAll('[data-gallery-slide]')];
    const thumbs = [...gallery.querySelectorAll('[data-gallery-thumb]')];

    if (!slides.length) return;

    let activeIndex = slides.findIndex((slide) => slide.classList.contains('product-gallery__slide--active'));
    if (activeIndex < 0) activeIndex = 0;

    // Mobile slider instance (Keen Slider)
    let mobileSlider = null;

    const syncHeights = () => {
      if (main && thumbsContainer) {
        const mainHeight = main.offsetHeight;
        if (mainHeight > 0) {
          thumbsContainer.style.maxHeight = mainHeight + 'px';
        }
      }
    };

    syncHeights();
    window.addEventListener('resize', syncHeights);

    const activeSlide = slides[activeIndex];
    if (activeSlide) {
      const img = activeSlide.querySelector('img');
      if (img) {
        if (img.complete) {
          syncHeights();
        } else {
          img.addEventListener('load', syncHeights);
        }
      }
    }

    const setActiveSlide = (index) => {
      const normalized = (index + slides.length) % slides.length;
      slides.forEach((slide, idx) => {
        slide.classList.toggle('product-gallery__slide--active', idx === normalized);
      });
      thumbs.forEach((thumb, idx) => {
        const isActive = idx === normalized;
        thumb.classList.toggle('product-gallery__thumb--active', isActive);
        thumb.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
      activeIndex = normalized;

      setTimeout(syncHeights, 50);
    };

    thumbs.forEach((thumb, idx) => {
      thumb.addEventListener('click', () => {
        if (mobileSlider) {
          mobileSlider.moveToIdx(idx);
          // Reset mobile autoplay after manual navigation
          stopMobileAutoPlay();
          startMobileAutoPlay();
        } else {
          setActiveSlide(idx);
          resetAutoPlay();
        }
      });
    });

    // Auto-play functionality - switch image every 5 seconds (desktop only)
    let autoPlayInterval;
    
    const startAutoPlay = () => {
      autoPlayInterval = setInterval(() => {
        const nextIndex = (activeIndex + 1) % slides.length;
        setActiveSlide(nextIndex);
      }, 5000);
    };

    const stopAutoPlay = () => {
      if (autoPlayInterval) {
        clearInterval(autoPlayInterval);
      }
    };

    const resetAutoPlay = () => {
      stopAutoPlay();
      startAutoPlay();
    };

    // Auto-play for mobile Keen Slider (every 5 seconds)
    let mobileAutoPlayInterval;

    const startMobileAutoPlay = () => {
      if (!mobileSlider) return;
      stopMobileAutoPlay();
      mobileAutoPlayInterval = setInterval(() => {
        if (!mobileSlider || !mobileSlider.track || !mobileSlider.track.details) return;
        const rel = mobileSlider.track.details.rel;
        mobileSlider.moveToIdx(rel + 1);
      }, 5000);
    };

    const stopMobileAutoPlay = () => {
      if (mobileAutoPlayInterval) {
        clearInterval(mobileAutoPlayInterval);
        mobileAutoPlayInterval = undefined;
      }
    };

    // Initialize Keen Slider on mobile (<= 480px)
    const initMobileSliderIfNeeded = () => {
      const isMobile = window.matchMedia('(max-width: 480px)').matches;
      if (isMobile && !mobileSlider && main) {
        // Add keen classes
        main.classList.add('keen-slider');
        slides.forEach((slide) => slide.classList.add('keen-slider__slide'));

        mobileSlider = new KeenSlider(main, {
          loop: true,
          slides: {
            perView: 1,
            spacing: 0,
          },
          drag: true,
        });

        mobileSlider.on('slideChanged', (s) => {
          const rel = s.track.details.rel;
          setActiveSlide(rel);
        });

        // Pause/resume autoplay on user interaction
        mobileSlider.on('dragStarted', () => {
          stopMobileAutoPlay();
        });
        mobileSlider.on('dragEnded', () => {
          startMobileAutoPlay();
        });

        // Start mobile autoplay when slider is active
        startMobileAutoPlay();

        // Stop desktop autoplay when mobile slider is active
        stopAutoPlay();
      } else if (!isMobile && mobileSlider) {
        // Destroy mobile slider when leaving mobile
        try { mobileSlider.destroy(); } catch(e) {}
        mobileSlider = null;
        // Stop mobile autoplay when destroying
        stopMobileAutoPlay();
        main.classList.remove('keen-slider');
        slides.forEach((slide) => slide.classList.remove('keen-slider__slide'));
        // Resume desktop autoplay
        startAutoPlay();
      }
    };

    // Start on load based on viewport
    if (!window.matchMedia('(max-width: 480px)').matches) {
      startAutoPlay();
    }
    initMobileSliderIfNeeded();
    window.addEventListener('resize', initMobileSliderIfNeeded);

    // Pause auto-play on hover
    if (main) {
      main.addEventListener('mouseenter', stopAutoPlay);
      main.addEventListener('mouseleave', startAutoPlay);
    }

    const optionSelects = document.querySelectorAll('[data-option-index]');
    const variantIdSelect = document.getElementById('VariantSelector-{{ section.id }}');

    if (optionSelects.length > 0 && variantIdSelect) {
      const updateVariant = () => {
        const selectedOptions = Array.from(optionSelects).map(select => select.value);
        const matchingVariant = Array.from(variantIdSelect.options).find(option => {
          const variantTitle = option.text;
          return selectedOptions.every(selectedOption => variantTitle.includes(selectedOption));
        });

        if (matchingVariant) {
          variantIdSelect.value = matchingVariant.value;
        }
      };

      optionSelects.forEach(select => {
        select.addEventListener('change', updateVariant);
      });
    }

    const accordionHeaders = document.querySelectorAll('.product-section__accordion-header');
    accordionHeaders.forEach((header) => {
      header.addEventListener('click', () => {
        const panel = header.nextElementSibling;
        header.classList.toggle('active');

        if (panel.style.maxHeight) {
          panel.style.maxHeight = null;
        } else {
          panel.style.maxHeight = panel.scrollHeight + 'px';
        }
      });
    });

    const initBeforeAfterSlider = (slider) => {
      const afterImage = slider.querySelector('[data-bv-after]');
      const handle = slider.querySelector('[data-bv-handle]');
      if (!afterImage || !handle) return;

      let isDragging = false;

      const updateSlider = (x) => {
        const rect = slider.getBoundingClientRect();
        let percentage = (x - rect.left) / rect.width;
        percentage = Math.max(0, Math.min(1, percentage));

        handle.style.left = (percentage * 100) + '%';
        afterImage.style.clipPath = `polygon(0 0, ${percentage * 100}% 0, ${percentage * 100}% 100%, 0 100%)`;
      };

      const onDragStart = (e) => {
        e.preventDefault();
        isDragging = true;
        window.addEventListener('mousemove', onDragMove);
        window.addEventListener('touchmove', onDragMove);
        window.addEventListener('mouseup', onDragEnd);
        window.addEventListener('touchend', onDragEnd);
      };

      const onDragMove = (e) => {
        if (!isDragging) return;
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        updateSlider(clientX);
      };

      const onDragEnd = () => {
        isDragging = false;
        window.removeEventListener('mousemove', onDragMove);
        window.removeEventListener('touchmove', onDragMove);
        window.removeEventListener('mouseup', onDragEnd);
        window.removeEventListener('touchend', onDragEnd);
      };

      handle.addEventListener('mousedown', onDragStart);
      handle.addEventListener('touchstart', onDragStart, { passive: false });
    };

    document.querySelectorAll('[data-bv-slider]').forEach(initBeforeAfterSlider);

    // Slider navigation
    const sliderContainers = document.querySelectorAll('[data-bv-slider]');
    const prevButton = document.querySelector('.bv-slider-nav-button--prev');
    const nextButton = document.querySelector('.bv-slider-nav-button--next');
    let currentSlideIndex = 0;

    const updateActiveSlide = (newIndex) => {
      sliderContainers.forEach((container, index) => {
        container.classList.toggle('active', index === newIndex);
      });
      currentSlideIndex = newIndex;
    };

    if (prevButton && nextButton) {
      prevButton.addEventListener('click', () => {
        const newIndex = currentSlideIndex === 0 ? sliderContainers.length - 1 : currentSlideIndex - 1;
        updateActiveSlide(newIndex);
      });

      nextButton.addEventListener('click', () => {
        const newIndex = (currentSlideIndex + 1) % sliderContainers.length;
        updateActiveSlide(newIndex);
      });
    }
  });
</script>

