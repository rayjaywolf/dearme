{% comment %}
  Cart section with modern design matching Dear Me brand
{% endcomment %}

<section class="cart-section">
  <div class="cart-section__container">
    <div class="cart-section__header">
      <h1 class="cart-section__title">{{ 'cart.title' | t }}</h1>
      {% if cart.item_count > 0 %}
        <p class="cart-section__count">
          {{ cart.item_count }}
          {{ cart.item_count | pluralize: 'item', 'items' }}
        </p>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" class="cart-section__form">
        <div class="cart-section__items">
          {% for item in cart.items %}
            <div class="cart-section__item">
              <div class="cart-section__item-image">
                {% if item.image %}
                  <img
                    src="{{ item.image | img_url: '200x200' }}"
                    alt="{{ item.image.alt | default: item.product.title }}"
                    class="cart-section__item-img"
                    loading="lazy"
                  >
                {% else %}
                  <div class="cart-section__item-placeholder">
                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                      <rect width="40" height="40" fill="#f5f5f5"/>
                      <path d="M20 12L28 20L20 28L12 20L20 12Z" fill="#ddd"/>
                    </svg>
                  </div>
                {% endif %}
              </div>

              <div class="cart-section__item-details">
                <h3 class="cart-section__item-title">{{ item.product.title }}</h3>
                {% if item.variant.title != 'Default Title' %}
                  <p class="cart-section__item-variant">{{ item.variant.title }}</p>
                {% endif %}
                {% if item.selling_plan_allocation %}
                  <p class="cart-section__item-subscription">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                {% endif %}
                <div class="cart-section__item-price">
                  {% if item.original_price != item.final_price %}
                    <span class="cart-section__item-price-original">{{ item.original_price | money }}</span>
                    <span class="cart-section__item-price-sale">{{ item.final_price | money }}</span>
                  {% else %}
                    <span class="cart-section__item-price-regular">{{ item.final_price | money }}</span>
                  {% endif %}
                </div>
              </div>

              <div class="cart-section__item-controls">
                <div class="cart-section__quantity">
                  <button
                    type="button"
                    class="cart-section__quantity-btn cart-section__quantity-btn--minus"
                    data-action="decrease"
                  >
                    -
                  </button>
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="cart-section__quantity-input"
                    data-line="{{ forloop.index }}"
                  >
                  <button
                    type="button"
                    class="cart-section__quantity-btn cart-section__quantity-btn--plus"
                    data-action="increase"
                  >
                    +
                  </button>
                </div>

                <div class="cart-section__item-total">
                  {{ item.final_line_price | money }}
                </div>

                <a href="{{ item.url_to_remove }}" class="cart-section__remove" data-action="remove">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M12 4L4 12M4 4L12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </a>
              </div>
            </div>
          {% endfor %}
        </div>

        <div class="cart-section__summary">
          <div class="cart-section__summary-content">
            <div class="cart-section__summary-row">
              <span class="cart-section__summary-label">Subtotal</span>
              <span class="cart-section__summary-value">{{ cart.total_price | money }}</span>
            </div>

            {% if cart.total_discounts > 0 %}
              <div class="cart-section__summary-row cart-section__summary-row--discount">
                <span class="cart-section__summary-label">Discount</span>
                <span class="cart-section__summary-value">-{{ cart.total_discounts | money }}</span>
              </div>
            {% endif %}

            <div class="cart-section__summary-row cart-section__summary-row--total">
              <span class="cart-section__summary-label">Total</span>
              <span class="cart-section__summary-value">{{ cart.total_price | money }}</span>
            </div>

            <button type="submit" name="checkout" class="cart-section__checkout-btn">
              <span class="cart-section__checkout-text">Checkout</span>
              <div class="cart-section__checkout-cta">
                <svg class="cart-section__checkout-cta-icon" width="13" height="8" viewBox="0 0 13 8" fill="none">
                  <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
                </svg>
                <svg class="cart-section__checkout-cta-icon" width="13" height="8" viewBox="0 0 13 8" fill="none">
                  <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
                </svg>
              </div>
            </button>

            <div class="cart-section__continue">
              <a href="{{ routes.all_products_collection_url }}" class="cart-section__continue-link">
                Continue Shopping
              </a>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <div class="cart-section__empty">
        <div class="cart-section__empty-content">
          <h2 class="cart-section__empty-title">Your cart is empty</h2>
          <p class="cart-section__empty-text">Looks like you haven't added anything to your cart yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="cart-section__empty-btn">
            <span class="cart-section__empty-btn-text">Start Shopping</span>
            <div class="cart-section__empty-btn-cta">
              <svg class="cart-section__empty-btn-cta-icon" width="13" height="8" viewBox="0 0 13 8" fill="none">
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
              <svg class="cart-section__empty-btn-cta-icon" width="13" height="8" viewBox="0 0 13 8" fill="none">
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .cart-section {
    background: #fef9f2 url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
    min-height: 100vh;
  }

  .cart-section__container {
    margin: 0 auto;
  }

  .cart-section__header {
    max-width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 35vh;
    background: #ead1c1 url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
    margin-bottom: 0;
    margin-top: 5rem;
  }

  .cart-section__title {
    font-family: 'Instrument Serif', serif;
    font-size: 3rem;
    font-weight: 300;
    color: #63001f;
    line-height: 1.3;
    margin-bottom: 3rem;
    text-align: center;
  }

  .cart-section__count {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #fef9f2;
    opacity: 0.7;
  }

  .cart-section__form {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 3rem;
    align-items: start;
  }

  .cart-section__items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cart-section__item {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 1.5rem;
    padding: 1.5rem;
    background: #fff;
    border-radius: 16px;
    border: 1px solid #e5e5e5;
    align-items: center;
  }

  .cart-section__item-image {
    width: 120px;
    height: 120px;
    border-radius: 12px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .cart-section__item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-section__item-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
  }

  .cart-section__item-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-section__item-title {
    font-family: 'Instrument Serif', serif;
    font-size: 1.25rem;
    font-weight: 400;
    color: #63001f;
    margin: 0;
  }

  .cart-section__item-variant {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #63001f;
    opacity: 0.7;
    margin: 0;
  }

  .cart-section__item-subscription {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: #63001f;
    opacity: 0.8;
    margin: 0;
  }

  .cart-section__item-price {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .cart-section__item-price-original {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #999;
    text-decoration: line-through;
  }

  .cart-section__item-price-sale {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #63001f;
  }

  .cart-section__item-price-regular {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #63001f;
  }

  .cart-section__item-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-end;
  }

  .cart-section__quantity {
    display: flex;
    align-items: center;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
  }

  .cart-section__quantity-btn {
    width: 32px;
    height: 32px;
    border: none;
    background: #f5f5f5;
    color: #63001f;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .cart-section__quantity-btn:hover {
    background: #e5e5e5;
  }

  .cart-section__quantity-input {
    width: 60px;
    height: 32px;
    border: none;
    text-align: center;
    font-size: 0.9rem;
    color: #63001f;
    background: #fff;
  }

  .cart-section__item-total {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #63001f;
    text-align: right;
  }

  .cart-section__remove {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .cart-section__remove:hover {
    background: #f5f5f5;
    color: #63001f;
  }

  .cart-section__summary {
    position: sticky;
    top: 2rem;
  }

  .cart-section__summary-content {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid #e5e5e5;
  }

  .cart-section__summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid #f5f5f5;
  }

  .cart-section__summary-row--total {
    border-bottom: none;
    border-top: 2px solid #63001f;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .cart-section__summary-label {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #63001f;
  }

  .cart-section__summary-value {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #63001f;
  }

  .cart-section__checkout-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    gap: 4rem;
    overflow: hidden;
    background-color: #63001f;
    color: #fef9f2;
    margin: 1.5rem 0;
    width: 100%;
    cursor: pointer;
  }

  .cart-section__checkout-text {
    margin-right: 1rem;
    padding-left: 0.5rem;
    color: #fef9f2;
  }

  .cart-section__checkout-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
    background: #fef9f2;
  }

  .cart-section__checkout-cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
    fill: #63001f;
  }

  .cart-section__checkout-cta .cart-section__checkout-cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .cart-section__checkout-btn:hover {
    background-color: #fef9f2 !important;
    color: #63001f !important;
    border: 1px solid #63001f !important;
  }

  .cart-section__checkout-btn:hover .cart-section__checkout-text {
    color: #63001f !important;
  }

  .cart-section__checkout-btn:hover .cart-section__checkout-cta {
    background: #63001f !important;
  }

  .cart-section__checkout-btn:hover .cart-section__checkout-cta-icon {
    fill: #fef9f2 !important;
  }

  .cart-section__checkout-btn:hover .cart-section__checkout-cta .cart-section__checkout-cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .cart-section__checkout-btn:hover .cart-section__checkout-cta .cart-section__checkout-cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .cart-section__continue {
    text-align: center;
  }

  .cart-section__continue-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #63001f;
    text-decoration: underline;
    transition: opacity 0.2s ease;
  }

  .cart-section__continue-link:hover {
    opacity: 0.7;
  }

  .cart-section__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
  }

  .cart-section__empty-content {
    text-align: center;
    max-width: 400px;
  }

  .cart-section__empty-icon {
    margin-bottom: 2rem;
  }

  .cart-section__empty-title {
    font-family: 'Instrument Serif', serif;
    font-size: 2rem;
    font-weight: 300;
    color: #63001f;
    margin-bottom: 1rem;
  }

  .cart-section__empty-text {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #63001f;
    opacity: 0.7;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .cart-section__empty-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    gap: 4rem;
    overflow: hidden;
    background-color: #fff;
    color: #63001f;
    margin: 0 auto;
    max-width: 270px;
  }

  .cart-section__empty-btn-text {
    margin-right: 1rem;
    padding-left: 1rem;
    color: #63001f;
  }

  .cart-section__empty-btn-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
    background: #63001f;
  }

  .cart-section__empty-btn-cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
    fill: #fef9f2;
  }

  .cart-section__empty-btn-cta .cart-section__empty-btn-cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .cart-section__empty-btn:hover {
    background-color: #63001f !important;
    color: #fef9f2 !important;
  }

  .cart-section__empty-btn:hover .cart-section__empty-btn-text {
    color: #fef9f2 !important;
  }

  .cart-section__empty-btn:hover .cart-section__empty-btn-cta {
    background: #fef9f2 !important;
  }

  .cart-section__empty-btn:hover .cart-section__empty-btn-cta-icon {
    fill: #63001f !important;
  }

  .cart-section__empty-btn:hover .cart-section__empty-btn-cta .cart-section__empty-btn-cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .cart-section__empty-btn:hover .cart-section__empty-btn-cta .cart-section__empty-btn-cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  /* Mobile optimizations */
  @media screen and (max-width: 768px) {
    .cart-section {
    }

    .cart-section__header {
      height: 35vh;
      padding: 1rem;
    }

    .cart-section__title {
      font-size: 3rem;
      margin-bottom: 2rem;
    }

    .cart-section__form {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .cart-section__item {
      grid-template-columns: 100px 1fr;
      gap: 1rem;
      padding: 1rem;
    }

    .cart-section__item-controls {
      grid-column: 1 / -1;
      flex-direction: row;
      justify-content: space-between;
      margin-top: 1rem;
    }

    .cart-section__summary {
      position: static;
    }

    .cart-section__summary-content {
      padding: 1.5rem;
    }
  }

  @media screen and (max-width: 480px) {
    .cart-section__header {
      height: 20vh;
      margin-top: 4rem;
    }

    .cart-section__title {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
    }

    .cart-section__item {
      grid-template-columns: 80px 1fr;
      padding: 0.75rem;
    }

    .cart-section__item-image {
      width: 80px;
      height: 80px;
    }

    .cart-section__item-title {
      font-size: 1.1rem;
    }

    .cart-section__summary-content {
      padding: 1rem;
    }

    .cart-section__checkout-btn {
      font-size: 0.8rem;
      padding: 0.6rem 0.8rem;
      gap: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
