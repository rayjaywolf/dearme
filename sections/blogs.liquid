{% comment %}
  1. Assigning articles from the blog with the correct handle: 'blog-posts'.
  2. We use bracket notation ['blog-posts'] because the handle contains a hyphen.
{% endcomment %}
{% assign articles_list = blogs['blog-posts'].articles %}

<section
  class="blogs-section"
  style="background: {{ section.settings.background_color }} url('{{ "noise.png" | asset_url }}'); background-size: 150px 150px; background-repeat: repeat;"
>
  <div class="blogs-section__container">
    <div class="blogs-section__columns">
      <div class="blogs-section__column blogs-section__column--left">
        <div class="blogs-section__row">
          <div class="blogs-section__text">
            <h3 class="blogs-section__subheading">our blog</h3>
            <h2 class="blogs-section__heading">News & Stories</h2>
            <a
              href="{{ blogs['blog-posts'].url }}"
              class="blogs-section__button"
              style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }}; border-color: {{ section.settings.button_border_color }}; font-family: {{ section.settings.button_font }}, sans-serif; text-transform: {{ section.settings.button_transform }}; font-style: {{ section.settings.button_style }};"
            >
              <span class="blogs-section__button-text" style="color: {{ section.settings.button_text_color }};"
                >Read all articles</span
              >
              <div class="blogs-section__cta" style="background: {{ section.settings.button_arrow_bg }};">
                <svg
                  class="blogs-section__cta-icon"
                  width="13"
                  height="8"
                  viewBox="0 0 13 8"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  style="fill: {{ section.settings.button_arrow_color }};"
                >
                  <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
                </svg>
                <svg
                  class="blogs-section__cta-icon"
                  width="13"
                  height="8"
                  viewBox="0 0 13 8"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  style="fill: {{ section.settings.button_arrow_color }};"
                >
                  <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
                </svg>
              </div>
            </a>
          </div>
        </div>
      </div>
      <div class="blogs-section__column blogs-section__column--right">
        <div class="blogs-section__articles">
          {% for article in articles_list limit: 3 %}
            <a href="{{ article.url }}" class="blogs-section__article">
              <div class="blogs-section__article-text">
                <div class="blogs-section__article-date">{{ article.published_at | time_tag: format: 'date' }}</div>
                <h4 class="blogs-section__article-title">{{ article.title }}</h4>
              </div>
              <div class="blogs-section__article-media">
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  alt="{{ article.title }}"
                  class="blogs-section__article-image"
                  loading="lazy"
                >
                <span class="blogs-section__article-cta">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .blogs-section {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    background-color: #ead1c1 !important;
  }

  .blogs-section__container {
    width: 100%;
    margin: 0;
    padding: 2rem;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .blogs-section__columns {
    display: grid;
    grid-template-columns: 28% 72%;
    gap: 1rem;
    width: 100%;
    height: 100%;
    margin-bottom: 3rem;
    margin-top: 3rem;
  }

  .blogs-section__column {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 2rem;
    overflow: hidden;
  }

  .blogs-section__column--left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
  }

  .blogs-section__row {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0rem;
  }

  .blogs-section__text {
    text-align: left;
    max-width: 100%;
  }

  .blogs-section__subheading {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: uppercase;
    color: #63001f;
    margin: 0 0 1rem 0;
    letter-spacing: 0.1em;
  }

  .blogs-section__heading {
    font-family: 'Instrument Serif', serif;
    font-size: 48px;
    font-weight: 200;
    line-height: 1.2;
    color: #63001f;
    margin: 0 0 2rem 0;
    text-align: left;
  }

  .blogs-section__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    gap: 4rem;
    overflow: hidden;
    max-width: 300px;
    margin-top: 2rem;
  }

  .blogs-section__button-text {
    margin-right: 1rem;
    padding-left: 1rem;
  }

  .blogs-section__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
  }

  .blogs-section__cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
  }

  .blogs-section__cta .blogs-section__cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .blogs-section__button:hover .blogs-section__cta .blogs-section__cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .blogs-section__button:hover .blogs-section__cta .blogs-section__cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .blogs-section__button:hover {
    background-color: {{ section.settings.button_text_color }} !important;
    color: {{ section.settings.button_bg_color }} !important;
    border: none !important;
  }
  .blogs-section__button:hover .blogs-section__button-text {
    color: {{ section.settings.button_bg_color }} !important;
  }
  .blogs-section__button:hover .blogs-section__cta {
    background: {{ section.settings.button_bg_color }} !important;
  }
  .blogs-section__button:hover .blogs-section__cta-icon {
    fill: {{ section.settings.button_text_color }} !important;
  }

  .blogs-section__column--right {
    overflow: hidden;
    max-width: 100%;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0;
  }

  .blogs-section__articles {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    width: 100%;
    max-width: 100%;
    scrollbar-width: none;
    -ms-overflow-style: none;
    box-sizing: border-box;
  }

  .blogs-section__articles::-webkit-scrollbar {
    display: none;
  }

  .blogs-section__article {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    width: 420px;
    text-decoration: none;
    color: inherit;
  }

  .blogs-section__article-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .blogs-section__article-date {
    font-size: 12px;
    color: #666;
    margin: 0 0 0.5rem 0;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blogs-section__article-title {
    font-size: 20px;
    font-weight: bold;
    color: #63001f;
    margin: 0 0 0.5rem 0;
    text-align: left;
    text-transform: uppercase;
    width: 80%;
  }

  .blogs-section__article-media {
    position: relative;
    width: 420px;
    height: 312px;
    margin-top: 1.5rem;
  }

  .blogs-section__article-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    flex-shrink: 0;
  }

  .blogs-section__article-cta {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #63001f;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: background 0.1s ease, color 0.1s ease, border-color 0.1s ease;
  }

  .blogs-section__article:hover .blogs-section__article-cta {
    background: #63001f;
    color: white;
    border-color: #63001f;
  }

  .blogs-section__article:hover .blogs-section__article-cta svg {
    stroke: #ffffff;
    transition: stroke 0.3s ease;
  }

  @media screen and (max-width: 480px) {
    .blogs-section__container {
      padding: 0rem 0.5rem;
      padding-right: 0;
    }

    .blogs-section__columns {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .blogs-section__column {
      padding: 0rem;
    }

    .blogs-section__column--left {
      padding: 0.5rem;
    }

    .blogs-section__column--right {
      padding: 0;
    }

    .blogs-section__heading {
      font-size: 32px;
      margin-bottom: 0.6rem;
      line-height: 1.05;
    }

    .blogs-section__subheading {
      font-size: 12px;
      margin-bottom: 0.5rem;
    }

    .blogs-section__button {
      font-size: 12px;
      padding: 0.4rem 0.4rem;
      gap: 2rem;
      max-width: 250px;
      margin-top: 1.5rem;
    }

    .blogs-section__button-text {
      margin-right: 0.8rem;
      padding-left: 0.8rem;
    }

    .blogs-section__cta {
      width: 2rem;
      height: 2rem;
    }

    .blogs-section__cta-icon {
      width: 12px;
      height: 8px;
    }

    .blogs-section__article {
      width: 280px;
    }

    .blogs-section__article:last-child {
      margin-right: 0.5rem;
    }

    .blogs-section__article-date {
      font-size: 10px;
      transform: translateX(0.5rem);
    }

    .blogs-section__article-title {
      font-size: 12px;
      line-height: 1.4;
      transform: translateX(0.5rem);
    }

    .blogs-section__article-media {
      width: 280px;
      height: 200px;
      margin-top: 1rem;
    }

    .blogs-section__article-image {
      width: 100%;
      height: 100%;
    }

    .blogs-section__article-cta {
      width: 32px;
      height: 32px;
      bottom: 10px;
      right: 10px;
    }

    .blogs-section__article-cta svg {
      width: 12px;
      height: 12px;
    }

    .blogs-section__articles {
      gap: 0.6rem;
    }
  }
</style>

