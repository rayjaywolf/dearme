    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#aa336a"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_arrow_bg",
      "label": "Button Arrow Background",
      "default": "#AA336A"
    },
    {
      "type": "color",
      "id": "button_arrow_color",
