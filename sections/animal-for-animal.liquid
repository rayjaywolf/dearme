{% comment %}
  Animal for Animal Section
{% endcomment %}
<div class="animal-for-animal">
  <section class="animal-for-animal__section" style="background: {{ section.settings.background_color }};">
    <div class="animal-for-animal__container">
      <div class="animal-for-animal__media">
        <img
          src="{{ 'afa.png' | asset_url }}"
          alt="Animal for Animal"
          class="animal-for-animal__image"
          loading="lazy"
          width="300"
          height="300"
        >
      </div>
      <div class="animal-for-animal__content">
        <p
          class="animal-for-animal__text js-animated-title"
          style=""
        >
          Our 'Animal for Animal' promise is simple: every purchase you make helps an animal in need. We believe in the
          deep connection between all living beings, which is why a portion of every Dear Me order goes directly towards
          nourishing stray animals. Your choice becomes an act of kindness, helping us build a world where compassion is
          extended to every corner of the animal kingdom.
        </p>
        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_link | default: '/pages/animal-for-animal' }}"
            class="animal-for-animal__button"
            style="background-color: {{ section.settings.button_bg_color }}; color: {{ section.settings.button_text_color }}; border-color: {{ section.settings.button_border_color }}; font-family: {{ section.settings.button_font }}, sans-serif; text-transform: {{ section.settings.button_transform }}; font-style: {{ section.settings.button_style }};"
          >
            <span class="animal-for-animal__button-text" style="color: {{ section.settings.button_text_color }};">
              {{- section.settings.button_label -}}
            </span>
            <div class="animal-for-animal__cta" style="background: {{ section.settings.button_arrow_bg }};">
              <svg
                class="animal-for-animal__cta-icon"
                width="13"
                height="8"
                viewBox="0 0 13 8"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                style="fill: {{ section.settings.button_arrow_color }};"
              >
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
              <svg
                class="animal-for-animal__cta-icon"
                width="13"
                height="8"
                viewBox="0 0 13 8"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                style="fill: {{ section.settings.button_arrow_color }};"
              >
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
            </div>
          </a>
        {% endif %}
      </div>
    </div>
  </section>
</div>

<style>
  .animal-for-animal {
    background: #fef9f2 url('{{ 'noise.png' | asset_url }}');
    background-repeat: repeat;
    background-size: auto;
    padding: 1rem;
    padding-top: 0;
  }
  .animal-for-animal__section {
    width: auto;
    padding: 4rem 0 4rem 0;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
  }
  .animal-for-animal__container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    max-width: 1200px;
    gap: 4rem;
    width: 100%;
    padding: 0 2rem;
    box-sizing: border-box;
  }
  .animal-for-animal__media {
    flex: 1;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }
  .animal-for-animal__image {
    width: 300px;
    height: auto;
  }
  .animal-for-animal__content {
    flex: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }
  .animal-for-animal__text {
    width: 100%;
    line-height: 1.7;
    color: #fff;
    font-size: 18px
  }
  .animal-for-animal__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    margin-top: 3rem;
    gap: 4rem;
    overflow: hidden;
  }
  .animal-for-animal__button-text {
    margin-right: 1rem;
    padding-left: 1rem;
  }
  .animal-for-animal__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
  }
  .animal-for-animal__cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
  }
  .animal-for-animal__cta .animal-for-animal__cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }
  .animal-for-animal__button:hover .animal-for-animal__cta .animal-for-animal__cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }
  .animal-for-animal__button:hover .animal-for-animal__cta .animal-for-animal__cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }
  .animal-for-animal__button:hover {
    background-color: #aa336a !important;
    color: {{ section.settings.button_bg_color }} !important;
    border: none !important;
  }
  .animal-for-animal__button:hover .animal-for-animal__button-text {
    color: {{ section.settings.button_bg_color }} !important;
  }
  .animal-for-animal__button:hover .animal-for-animal__cta {
    background: {{ section.settings.button_bg_color }} !important;
  }
  .animal-for-animal__button:hover .animal-for-animal__cta-icon {
    fill: #aa336a !important;
  }
  /* Mobile responsive adjustments */
  @media screen and (max-width: 480px) {
    .animal-for-animal {
      padding: 0.5rem;
    }

    .animal-for-animal__section {
      padding: 2rem 0;
    }

    .animal-for-animal__container {
      flex-direction: column;
      gap: 2rem;
      padding: 0 1rem;
    }

    .animal-for-animal__media {
      order: 1;
    }

    .animal-for-animal__content {
      order: 2;
      align-items: center;
      text-align: center;
    }

    .animal-for-animal__image {
      width: 150px;
    }

    .animal-for-animal__text {
      font-family: "Inter", sans-serif;
      font-size: 14px;
      line-height: 1.4;
      padding: 0;
      text-align: justify;
    }

    .animal-for-animal__button {
      font-size: 12px;
      padding: 0.4rem 0.4rem;
      gap: 2rem;
      max-width: 250px;
      margin-top: 2rem;
    }

    .animal-for-animal__button-text {
      margin-right: 0.8rem;
      padding-left: 0.8rem;
    }

    .animal-for-animal__cta {
      width: 2rem;
      height: 2rem;
    }

    .animal-for-animal__cta-icon {
      width: 12px;
      height: 8px;
    }
  }
</style>

{% schema %}
{
  "name": "Animal for Animal",
  "settings": [
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "color",
