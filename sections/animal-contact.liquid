{% comment %}
  Animal for Animal Contact Section
{% endcomment %}

<section class="animal-contact-section-container">
  <section class="animal-contact-section">
    <div class="animal-contact-section__container">
      <div class="animal-contact-section__content">
        <h2 class="animal-contact-section__title">Want to connect with us?</h2>

        <div class="animal-contact-section__contact-info">
          <p class="animal-contact-section__email-label">Mail us at</p>

          <a
            href="mailto:afa@dearme.in"
            class="animal-contact-section__email-link"
          >
            afa@dearme.in
          </a>
        </div>

        <div class="animal-contact-section__cta">
          <a
            href="/collections/all"
            class="animal-contact-section__button"
          >
            <span class="animal-contact-section__button-text"> Support Our Mission </span>
            <div class="animal-contact-section__cta-arrow">
              <svg
                class="animal-contact-section__cta-icon"
                width="13"
                height="8"
                viewBox="0 0 13 8"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
              <svg
                class="animal-contact-section__cta-icon"
                width="13"
                height="8"
                viewBox="0 0 13 8"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
</section>

<style>
  .animal-contact-section-container {
    background: #fef9f2 url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
    padding: 1rem;
  }
  .animal-contact-section {
    padding: 3rem 0;
    position: relative;
    background: #fe5f78;
    border-radius: 16px;
  }

  .animal-contact-section__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 4rem;
  }

  .animal-contact-section__content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .animal-contact-section__title {
    font-family: 'Instrument Serif', serif;
    font-size: 3rem;
    font-weight: 300;
    line-height: 1.3;
    margin-bottom: 3rem;
    color: #fff;
    text-transform: none;
    font-style: normal;
  }

  .animal-contact-section__contact-info {
    margin-bottom: 4rem;
  }

  .animal-contact-section__email-label {
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 400;
    margin: 0 0 1rem 0;
    color: #fff;
    line-height: 1.6;
  }

  .animal-contact-section__email-link {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: #fff;
    text-decoration: underline;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .animal-contact-section__email-link:hover {
    opacity: 0.8;
  }

  .animal-contact-section__cta {
    display: flex;
    justify-content: center;
  }

  .animal-contact-section__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    gap: 4rem;
    overflow: hidden;
    background-color: #ffffff;
    color: #63001f;
    border-color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-style: normal;
  }

  .animal-contact-section__button-text {
    margin-right: 1rem;
    padding-left: 1rem;
    color: #aa336a;
  }

  .animal-contact-section__cta-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
    background: #aa336a;
  }

  .animal-contact-section__cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
    fill: #ffffff;
  }

  .animal-contact-section__cta-arrow .animal-contact-section__cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .animal-contact-section__button:hover
    .animal-contact-section__cta-arrow
    .animal-contact-section__cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .animal-contact-section__button:hover
    .animal-contact-section__cta-arrow
    .animal-contact-section__cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  .animal-contact-section__button:hover {
    background-color: #aa336a !important;
    color: #ffffff !important;
    border: none !important;
  }

  .animal-contact-section__button:hover .animal-contact-section__button-text {
    color: #ffffff !important;
  }

  .animal-contact-section__button:hover .animal-contact-section__cta-arrow {
    background: #ffffff !important;
  }

  .animal-contact-section__button:hover .animal-contact-section__cta-icon {
    fill: #aa336a !important;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .animal-contact-section {
      padding: 4rem 0;
    }

    .animal-contact-section__container {
      padding: 0 2rem;
    }

    .animal-contact-section__title {
      font-size: 2.5rem !important;
      margin-bottom: 2rem;
    }

    .animal-contact-section__email-label,
    .animal-contact-section__email-link {
      font-size: 1.1rem !important;
    }

    .animal-contact-section__button {
      font-size: 0.75rem !important;
      padding: 0.6rem 1rem;
      gap: 2rem;
      min-width: 200px;
    }
  }

  @media (max-width: 480px) {
    .animal-contact-section__container {
      padding: 0 1rem;
    }

    .animal-contact-section__title {
      font-size: 2rem !important;
    }

    .animal-contact-section__email-label,
    .animal-contact-section__email-link {
      font-size: 1rem !important;
    }

    .animal-contact-section__button {
      font-size: 0.7rem !important;
      padding: 0.5rem 0.7rem;
      gap: 1.5rem;
      min-width: 180px;
    }
  }
</style>
