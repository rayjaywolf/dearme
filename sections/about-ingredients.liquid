    transition: background-color 0.3s ease;
    border: none;
    gap: 4rem;
    overflow: hidden;
    max-width: 300px;
    margin: 0 auto;
    cursor: pointer;
    background-color: #63001f;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-style: normal;
  }

  .about-ingredients__button .about-ingredients__button-label {
    color: #ffffff;
  }

  .about-ingredients__button .about-ingredients__cta {
    background: #ffffff;
  }

  .about-ingredients__button .about-ingredients__cta-icon {
