<style>
  .marquee-section {
    width: 100%;
    padding: 1rem 0;
    overflow: hidden;
    position: relative;
    background: #63001f;
  }

  .marquee-wrapper {
    display: flex;
    width: 100%;
    overflow: hidden;
    gap: 1rem;
  }

  .marquee-content {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    animation: scroll 25s linear infinite;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .marquee-content li {
    font-family: 'Inter', serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: lowercase;
    color: #fef9f2;
    white-space: nowrap;
    padding: 0;
    margin: 0;
  }

  .marquee-content li.divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0.25rem;
  }

  .marquee-content li.divider svg {
    width: 75px;
    height: 10px;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media (max-width: 768px) {
    .marquee-section {
      padding: 1rem 0;
    }

    .marquee-content li {
      font-size: 1rem;
    }
  }
</style>

