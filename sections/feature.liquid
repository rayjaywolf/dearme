{% comment %}
  Feature Section
{% endcomment %}

<section
  class="feature-section"
  style="--section-bg: {{ section.settings.background_color }};"
>
  <div class="feature-section__container">
    <div class="feature-section__columns">
      <div class="feature-section__column feature-section__column--left">
        <img src="{{ 'orange.png' | asset_url }}" alt="Orange" class="feature-section__image">
      </div>
      <div
        class="feature-section__column feature-section__column--right"
        style="--column-bg: {{ section.settings.column_bg }};"
      >
        {%- if section.settings.heading != blank -%}
          <div
            class="feature-section__headline"
            style="
              --heading-color: {{ section.settings.heading_color }};
              --heading-font-size: {{ section.settings.heading_font_size }}px;
              --heading-font-weight: {{ section.settings.heading_font_weight }};
              --heading-text-transform: {{ section.settings.heading_text_transform }};
            "
          >
            {{ section.settings.heading }}
          </div>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div
            class="feature-section__subheadline"
            style="
              --description-color: {{ section.settings.description_color }};
              --description-font-size: {{ section.settings.description_font_size }}px;
              --description-font-weight: {{ section.settings.description_font_weight }};
              --description-text-transform: {{ section.settings.description_text_transform }};
            "
          >
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .feature-section {
    height: 100%;
    width: 100%;
    padding: 1rem;
    padding-bottom: 0;
    background: var(--section-bg, #fef9f2) url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
  }

  .feature-section__container {
    max-width: 100%;
    margin: 0 auto;
  }

  .feature-section__columns {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 1rem;
    width: 100%;
  }

  .feature-section__column {
    background: var(--column-bg, #ead1c1) url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    border-radius: 16px;
  }

  .feature-section__column--right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .feature-section__headline {
    font-family: 'Instrument Serif', serif;
    line-height: 1.2;
    color: var(--heading-color, #63001f);
    margin: 0 0 1.5rem 0;
    text-align: center;
  }

  .feature-section__headline > * {
    font-size: var(--heading-font-size, 48px);
    font-weight: var(--heading-font-weight, 200);
    text-transform: var(--heading-text-transform, none);
    color: inherit;
    margin: 0;
    line-height: 1.2;
  }

  .feature-section__headline > *:first-child {
    margin-top: 0;
  }

  .feature-section__headline > *:last-child {
    margin-bottom: 0;
  }

  .feature-section__subheadline {
    color: var(--description-color, #63001f);
    margin: 0 auto;
    text-align: center;
    line-height: 1.4;
    width: 60%;
  }

  .feature-section__subheadline > * {
    font-size: var(--description-font-size, 14px);
    font-weight: var(--description-font-weight, 400);
    text-transform: var(--description-text-transform, uppercase);
    color: inherit;
    margin: 0;
    line-height: 1.4;
  }

  .feature-section__subheadline > *:first-child {
    margin-top: 0;
  }

  .feature-section__subheadline > *:last-child {
    margin-bottom: 0;
  }

  .feature-section__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
  }

  /* Mobile responsive adjustments */
  @media screen and (max-width: 480px) {
    .feature-section {
      padding: 0rem 1rem 0rem;
    }

    .feature-section__columns {
      grid-template-columns: 1fr;
      gap: 1rem;
      display: flex;
      flex-direction: column-reverse;
    }

    .feature-section__column {
      min-height: 180px;
    }

    .feature-section__column--right {
      padding: 1.5rem;
    }

    .feature-section__column--right h2 {
      width: 80%;
    }

    .feature-section__headline {
      margin-bottom: 1rem;
    }

    .feature-section__headline > * {
      font-size: 1.8rem;
      line-height: 1.1;
    }

    .feature-section__subheadline {
      width: 90%;
    }

    .feature-section__subheadline > * {
      font-size: 0.75rem;
      line-height: 1.3;
    }
  }
</style>

{% schema %}
{
  "name": "Feature Section",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<h2>Lightweight. <em> Silky.</em> Sensitive-Safe.</h2>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A fast-absorbing, fragrance-free serum that melts into your skin, leaving it soft, calm, and luminous.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#fef9f2"
    },
    {
      "type": "color",
      "id": "column_bg",
      "label": "Column Background Color",
      "default": "#ead1c1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#63001f"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#63001f"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#63001f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading Styling"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Font Size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra Light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "200"
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Description Styling"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Font Size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "description_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra Light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "description_text_transform",
      "label": "Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    }
  ],
  "presets": [
    {
      "name": "Feature Section"
    }
  ]
}
{% endschema %}