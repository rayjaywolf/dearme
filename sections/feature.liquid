{% comment %}
  Feature Section
{% endcomment %}

<section class="feature-section">
  <div class="feature-container">
    <div class="feature-columns">
      <div class="feature-column feature-column-left">
        <img src="{{ 'orange.png' | asset_url }}" alt="Orange" class="feature-image">
      </div>
      <div class="feature-column feature-column-right">
        <h2 class="feature-headline">Lightweight. <em> Silky.</em> Sensitive-Safe.</h2>
        <p class="feature-subheadline">
          A fast-absorbing, fragrance-free serum that melts into your skin, leaving it soft, calm, and luminous.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-section {
    height: 100%;
    width: 100%;
    padding: 1rem;
    background: #fef9f2 url('{{ "noise.png" | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
  }

  .feature-container {
    max-width: 100%;
    margin: 0 auto;
  }

  .feature-columns {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 1rem;
    width: 100%;
  }

  .feature-column {
    background-color: #ead1c1;
    border-radius: 16px;
  }

  .feature-column-left {
  }

  .feature-column-right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .feature-headline {
    font-family: 'Instrument Serif', serif;
    font-size: 48px;
    font-weight: 200;
    line-height: 1.2;
    color: #63001f;
    margin: 0 0 1.5rem 0;
    text-align: center;
  }

  .feature-subheadline {
    font-size: 14px;
    color: #63001f;
    margin: 0;
    text-align: center;
    line-height: 1.4;
    text-transform: uppercase;
    width: 60%;
    margin: 0 auto;
  }

  .feature-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
  }

  @media (max-width: 768px) {
    .feature-section {
      padding: 3rem 1rem;
    }

    .feature-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .feature-column {
      min-height: 200px;
      padding: 1.5rem;
    }

    .feature-headline {
      font-size: 2rem;
    }

    .feature-subheadline {
      font-size: 0.8rem;
    }
  }
</style>

{% schema %}
{
  "name": "Feature Section",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feature Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Feature description goes here."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fef9f2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#63001f"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#666"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#63001f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Feature Section"
    }
  ]
}
{% endschema %}
