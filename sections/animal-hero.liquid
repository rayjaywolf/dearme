{% comment %}
  Animal for Animal Hero Section
{% endcomment %}

<section class="animal-hero-section">
  <div class="animal-hero-section__overlay"></div>

  <div class="animal-hero-section__content">
    <h1 class="animal-hero-section__headline">
      We pledge our support to the voiceless souls, advocating for their <em>welfare</em> and the
      <em>preservation</em> of our shared <em>home</em>.
    </h1>
    <div class="animal-hero-section__image">
      <img
        src="{{ 'afa.png' | asset_url }}"
        alt="Animal for Animal Initiative"
        loading="lazy"
        width="400"
        height="400"
      >
    </div>
  </div>
</section>

<style>
  .animal-hero-section {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    overflow: hidden;
    position: relative;
    will-change: transform;
    background: #fe5f78;
    background-size: 150px 150px;
    background-repeat: repeat;
  }

  .animal-hero-section__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .animal-hero-section__content {
    z-index: 3;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    margin-top: 3rem;
  }

  .animal-hero-section__badge {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    backdrop-filter: blur(10px);
  }

  .animal-hero-section__badge-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .animal-hero-section__headline {
    font-family: 'Instrument Serif', serif;
    font-size: 3.5rem;
    font-weight: 300;
    line-height: 1.2;
    max-width: 800px;
    margin: 0 auto;
    color: #ffffff;
    text-transform: none;
    font-style: normal;
  }

  .animal-hero-section__image {
    margin-top: 2rem;
  }

  .animal-hero-section__image img {
    width: 300px;
    height: auto;
  }

  @media (max-width: 480px) {
    .animal-hero-section {
      padding: 1.5rem 0.75rem;
    }

    .animal-hero-section__headline {
      font-size: 2rem !important;
    }

    .animal-hero-section__image img {
      width: 150px;
    }
  }
</style>
