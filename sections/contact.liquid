{% comment %}
  Contact section
{% endcomment %}

<section class="contact-section">
  <div class="contact-section__container">
    <h1 class="contact-section__title">Contact Us</h1>
  </div>
  <div class="contact-section__content">
    <div class="contact-section__info">
      <h3 class="contact-section__info-title">Phone & Whatsapp</h3>
      <p class="contact-section__info-text">
        <strong style="text-decoration: underline; color: #63001f;">+91 9669 8200 89</strong>
      </p>
    </div>

    <div class="contact-section__info">
      <h3 class="contact-section__info-title">Email</h3>
      <p class="contact-section__info-text">
        General order related queries:<br>
        <strong style="text-decoration: underline; color: #63001f;">care@dearme.in</strong><br>
        Social media, press and media inquiries:<br>
        <strong style="text-decoration: underline; color: #63001f;">connect@dearme.in</strong>
      </p>
    </div>

    <div class="contact-section__info">
      <h3 class="contact-section__info-title">Address</h3>
      <p class="contact-section__info-text">
        <strong>San-O-Mants Healthcare (P) Limited</strong><br>
        Ground Floor, 116 Madhuban Colony,<br>
        Dewas (MP) 455001 India
      </p>
    </div>
  </div>

  <div class="contact-section__track">
    <a href="#" class="contact-section__track-button">
      <span class="contact-section__track-button-text">Track Your Order</span>
      <div class="contact-section__track-cta">
        <svg
          class="contact-section__track-cta-icon"
          width="13"
          height="8"
          viewBox="0 0 13 8"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
        </svg>
        <svg
          class="contact-section__track-cta-icon"
          width="13"
          height="8"
          viewBox="0 0 13 8"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M12.3536 4.35355C12.5488 4.15829 12.5488 3.84171 12.3536 3.64645L9.17157 0.464466C8.97631 0.269204 8.65973 0.269204 8.46447 0.464466C8.2692 0.659728 8.2692 0.976311 8.46447 1.17157L11.2929 4L8.46447 6.82843C8.2692 7.02369 8.2692 7.34027 8.46447 7.53553C8.65973 7.7308 8.97631 7.7308 9.17157 7.53553L12.3536 4.35355ZM0 4.5H12V3.5H0V4.5Z"></path>
        </svg>
      </div>
    </a>
  </div>
</section>

<style>
  .contact-section {
    padding: 0rem 0rem;
    background: #fef9f2 url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
  }
  .contact-section__container {
    max-width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 35vh;
    margin-top: 5rem;
    background: #ead1c1 url('{{ 'noise.png' | asset_url }}');
    background-size: 150px 150px;
    background-repeat: repeat;
  }
  .contact-section__title {
    font-family: 'Instrument Serif', serif;
    font-size: 3rem;
    font-weight: 300;
    color: #63001f;
    line-height: 1.3;
    margin-bottom: 3rem;
    text-align: center;
  }

  .contact-section__content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 0 2rem;
  }

  .contact-section__info {
    text-align: center;
    padding: 1.5rem;
    border-radius: 16px;
    background-color: #fff;
    border: 1px solid #63001f;
  }
  .contact-section__info-title {
    font-family: 'Instrument Serif', serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: #63001f;
    margin-bottom: 1rem;
  }
  .contact-section__info-text {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #63001f;
    line-height: 1.6;
    margin: 0;
  }

  .contact-section__track {
    text-align: center;
    padding: 1rem 0 3rem;
  }

  .contact-section__track-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.5rem;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 999px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    gap: 4rem;
    overflow: hidden;
    background-color: #fff;
    color: #63001f;
    margin: 0 auto;
    max-width: 300px;
  }

  .contact-section__track-button-text {
    margin-right: 1rem;
    padding-left: 1rem;
    color: #63001f;
  }

  .contact-section__track-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
    border-radius: 100%;
    height: 2.4rem;
    width: 2.4rem;
    position: relative;
    overflow: hidden;
    background: #63001f;
  }

  .contact-section__track-cta-icon {
    width: 15px;
    height: 10px;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scaleX(1);
    transform-origin: center;
    transition: transform 0.8s cubic-bezier(0.18, 0.71, 0.11, 1), opacity 0.8s cubic-bezier(0.18, 0.71, 0.11, 1);
    fill: #fef9f2;
  }

  .contact-section__track-cta .contact-section__track-cta-icon:last-child {
    left: 50%;
    opacity: 0;
    transform: translate(-300%, -50%) scaleX(2);
  }

  .contact-section__track-button {
    background-color: #63001f !important;
    color: #fef9f2 !important;
  }

  .contact-section__track-button .contact-section__track-button-text {
    color: #fef9f2 !important;
  }

  .contact-section__track-button .contact-section__track-cta {
    background: #fef9f2 !important;
  }

  .contact-section__track-button .contact-section__track-cta-icon {
    fill: #63001f !important;
  }

  .contact-section__track-button:hover {
    background-color: #fef9f2 !important;
    color: #63001f !important;
  }

  .contact-section__track-button:hover .contact-section__track-button-text {
    color: #63001f !important;
  }

  .contact-section__track-button:hover .contact-section__track-cta {
    background: #63001f !important;
  }

  .contact-section__track-button:hover .contact-section__track-cta-icon {
    fill: #fef9f2 !important;
  }

  .contact-section__track-button:hover .contact-section__track-cta .contact-section__track-cta-icon:first-child {
    opacity: 0;
    transform: translate(200%, -50%) scaleX(2);
  }

  .contact-section__track-button:hover .contact-section__track-cta .contact-section__track-cta-icon:last-child {
    opacity: 1;
    transform: translate(-50%, -50%) scaleX(1);
  }

  /* Mobile optimizations */
  @media screen and (max-width: 768px) {
    .contact-section__container {
      height: 35vh;
      padding: 1rem;
    }

    .contact-section__title {
      font-size: 3rem;
      margin-bottom: 2rem;
    }

    .contact-section__content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem 1rem;
      max-width: 100%;
    }

    .contact-section__info {
      padding: 1.5rem 1rem;
    }

    .contact-section__info-title {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .contact-section__info-text {
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .contact-section__track {
      padding: 1.5rem 1rem 2rem;
    }

    .contact-section__track-button {
      max-width: 280px;
      gap: 2rem;
      padding: 0.6rem 0.5rem;
      font-size: 0.75rem;
    }

    .contact-section__track-button-text {
      padding-left: 0.75rem;
    }

    .contact-section__track-cta {
      width: 2.2rem;
      height: 2.2rem;
    }

    .contact-section__track-cta-icon {
      width: 12px;
      height: 8px;
    }
  }

  @media screen and (max-width: 480px) {
    .contact-section__container {
      height: 20vh;
      padding: 0.5rem;
      margin-top: 4rem;
    }

    .contact-section__title {
      font-size: 40px;
      margin-bottom: 1.5rem;
    }

    .contact-section__content {
      padding: 1.5rem 1rem;
      gap: 0.5rem;
    }

    .contact-section__info {
      padding: 1.25rem 0.75rem;
    }

    .contact-section__info-title {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .contact-section__info-text {
      font-size: 0.85rem;
      line-height: 1.4;
    }

    .contact-section__track {
      padding: 0rem 0.75rem 1.5rem;
    }

    .contact-section__track-button {
      max-width: 260px;
      gap: 1.5rem;
      padding: 0.5rem 0.4rem;
      font-size: 0.7rem;
    }

    .contact-section__track-button-text {
      padding-left: 0.5rem;
    }

    .contact-section__track-cta {
      width: 2rem;
      height: 2rem;
    }

    .contact-section__track-cta-icon {
      width: 10px;
      height: 6px;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Section"
}
{% endschema %}
