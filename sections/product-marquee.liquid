<style>
  #shopify-section-{{ section.id }} .product-marquee-section {
    background-color: {{ section.settings.background_color }};
    {% if section.settings.show_noise_bg %}
      background-image: url('{{ 'noise.png' | asset_url }}');
      background-size: 150px 150px;
      background-repeat: repeat;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .product-marquee-section__content li {
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .product-marquee-section__divider svg circle {
    fill: {{ section.settings.divider_color }};
  }
</style>

