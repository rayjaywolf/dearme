    </ul>
  </div>
</section>

{% stylesheet %}
  .product-marquee-section {
    width: 100%;
    padding: 0.7rem 0;
    overflow: hidden;
  }

  .product-marquee-section__wrapper {
    display: flex;
    flex-shrink: 0;
    animation: product-marquee-scroll 30s linear infinite;
  }

  .product-marquee-section__wrapper:hover {
    animation-play-state: paused;
  }

  .product-marquee-section__content {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0.75rem;
    padding: 0 0.75rem;
    margin: 0;
    list-style: none;
    white-space: nowrap;
  }

  .product-marquee-section__content li {
    font-family: 'Inter', serif;
    font-size: 0.9rem;
    font-weight: 400;
    text-transform: capitalize;
    margin: 0;
  }

  .product-marquee-section__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0.25rem;
  }

  .product-marquee-section__divider svg {
    width: 50px;
    height: 8px;
    flex-shrink: 0;
  }

  @keyframes product-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 480px) {
    .product-marquee-section {
      padding: 1rem 0;
    }

    .product-marquee-section__content li {
      font-size: 12px;
    }

    .product-marquee-section__divider svg {
      width: 30px;
      height: 5px;
    }

    .product-marquee-section__wrapper {
      animation-duration: 10s;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Color & Style Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fef9f2"
    },
    {
      "type": "checkbox",
      "id": "show_noise_bg",
      "label": "Show noise background pattern",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#63001f"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider dot",
      "default": "#63001f"
    }
  ],
  "presets": [
    {
      "name": "Product Marquee"
    }
  ]
}
{% endschema %}
